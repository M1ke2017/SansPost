# Skopiuj do .env (plik .env jest w .gitignore). Bez sekretów — sekrety to pliki w SECRETS_DIR.
POSTGRES_DB=sanspost
POSTGRES_USER=sanspost
SECRETS_DIR=./secrets

# Adres strony dla Caddy: "localhost" (lokalny CA) lub prawdziwa domena (Let's Encrypt).
SANSPOST_SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

SANSPOST_TAG=local
SANSPOST_DB_MAX_POOL_SIZE=30
SANSPOST_MEM_LIMIT=1g

# Publiczne demo — jawnie.
SANSPOST_REGISTRATION_ENABLED=true
SANSPOST_MAX_PUBLIC_ACCOUNTS=100
SANSPOST_SEED_CONTENT=false

# Tylko przy jednorazowym bootstrapie admina (docker-compose.bootstrap.yml):
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
