<CascadingAuthenticationState>
    <CascadingValue Name="AntiforgeryToken" Value="AntiforgeryToken">
    <CascadingValue Name="ClientAddress" Value="ClientAddress">
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        @if (context.User.Identity?.IsAuthenticated != true)
                        {
                            <RedirectToLogin />
                        }
                        else
                        {
                            <PageTitle>@L["Brak dostępu · SansPost"]</PageTitle>
                            <EmptyState Title="Brak dostępu" HeadingLevel="1" IconName="@Icons.Lock"
                                        Text="Ta część SansPost jest dostępna tylko dla uprawnionych kont.">
                                <a class="btn btn-primary" href="@SaloonRoutes.Hub">@L["Wróć do odkrywania"]</a>
                            </EmptyState>
                        }
                    </NotAuthorized>
                    <Authorizing>
                        <p class="muted" role="status">@L["Sprawdzanie uprawnień…"]</p>
                    </Authorizing>
                </AuthorizeRouteView>
                @* Po nawigacji fokus trafia na nagłówek strony — czytnik ogłasza nowy widok, Tab zaczyna od treści. *@
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <NotFoundStatus />
                <PageTitle>@L["Nie znaleziono · SansPost"]</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <EmptyState Title="Nie ma tu nic do czytania" HeadingLevel="1" IconName="@Icons.Compass"
                                Text="Ten adres nie prowadzi do żadnej strony SansPost. Może link jest nieaktualny?">
                        <a class="btn btn-primary" href="@SaloonRoutes.Hub">@L["Wróć do odkrywania"]</a>
                        <a class="btn" href="/search">@L["Szukaj"]</a>
                    </EmptyState>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingValue>
    </CascadingValue>
</CascadingAuthenticationState>

@code {
    [Parameter]
    public string? AntiforgeryToken { get; set; }

    // Adres klienta z żądania strony (prerender) — klucz limitu wyszukiwania dla anonimów w circuicie,
    // gdzie HttpContext żądania nie jest już dostępny. Parametry komponentu z _Host są chronione (Data Protection).
    [Parameter]
    public string? ClientAddress { get; set; }

    // Renderer przestrzeni z ciasteczka "sp-scene" (prerender i circuit dostają tę samą wartość) — patrz ScenePreference.
    [Parameter]
    public string? SceneHint { get; set; }

    // Język interfejsu z żądania strony (cookie "sp-lang" / Accept-Language) — dalej zmieniany w miejscu (LanguageToggle).
    [Parameter]
    public string? Language { get; set; }

    [Inject] private ScenePreference Scene { get; set; } = default!;

    protected override void OnInitialized()
    {
        Scene.Renderer ??= ScenePreference.Parse(SceneHint);
        L.Initialize(Language);
    }
}
