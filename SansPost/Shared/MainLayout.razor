@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject UiServices Ui
@inject IJSRuntime JS
@inject ILogger<MainLayout> Logger
@inject Loc L

<a class="skip-link" href="#main">@L["Przejdź do treści"]</a>

<div class="app">
    <header class="app-header">
        <div class="app-header-inner">
            <Logo />

            <nav class="primary-nav" aria-label="@L["Główna nawigacja"]">
                <NavLink class="nav-link" href="@SaloonRoutes.Hub"><Icon Name="@Icons.Compass" /> @L["Odkrywaj"]</NavLink>
                <NavLink class="nav-link" href="/categories"><Icon Name="@Icons.Grid" /> @L["Kategorie"]</NavLink>
            </nav>

            <div class="header-actions">
                <form class="header-search" role="search" @onsubmit="SubmitSearchAsync">
                    <Icon Name="@Icons.Search" Size="16" />
                    <label class="visually-hidden" for="header-search">@L["Szukaj postów"]</label>
                    <input id="header-search" class="input" type="search" placeholder="@L["Szukaj postów…"]" maxlength="100"
                           autocomplete="off" @bind="headerQuery" />
                </form>

                <a class="btn btn-ghost btn-icon header-search-icon" href="/search" aria-label="@L["Szukaj"]" title="@L["Szukaj"]">
                    <Icon Name="@Icons.Search" />
                </a>

                @if (viewer is not null)
                {
                    <CascadingValue Value="viewer"><NotificationBell /></CascadingValue>
                }

                <LanguageToggle /><ThemeToggle />

                @if (viewer is null)
                {
                    <a class="btn btn-ghost header-desktop-only" href="@LoginHref">@L["Zaloguj się"]</a>
                    <a class="btn btn-primary" href="/register">@L["Załóż konto"]</a>
                }
                else
                {
                    <a class="btn btn-primary header-desktop-only" href="/new"><Icon Name="@Icons.Cactus" /> @L["Nowy post"]</a>

                    <div class="menu header-desktop-only">
                        <button type="button" class="menu-trigger" id="user-menu-trigger" aria-haspopup="true"
                                aria-expanded="@(menuOpen ? "true" : "false")" aria-controls="user-menu" @onclick="ToggleMenu">
                            <Avatar Username="@viewer.Username" Size="sm" />
                            <span class="truncate text-sm">@viewer.Username</span>
                            <Icon Name="@Icons.ChevronDown" Size="16" />
                        </button>

                        @if (menuOpen)
                        {
                            <button type="button" class="menu-backdrop" tabindex="-1" aria-hidden="true" @onclick="CloseMenu"></button>
                            <div class="menu-panel" id="user-menu" @onkeydown="MenuKeyDown">
                                <div class="menu-heading truncate">@L["Zalogowano jako"] <strong>@viewer.Username</strong></div>
                                <a class="menu-item" href="@UiText.ProfileUrl(viewer.Username)"><Icon Name="@Icons.User" /> @L["Mój profil"]</a>
                                <a class="menu-item" href="/me"><Icon Name="@Icons.FileText" /> @L["Moje konto i posty"]</a>
                                @if (viewer.IsAdmin)
                                {
                                    <a class="menu-item" href="/admin/moderation"><Icon Name="@Icons.Shield" /> @L["Moderacja"]</a>
                                }
                                <form method="post" action="auth/logout">
                                    <AntiforgeryField />
                                    <button type="submit" class="menu-item"><Icon Name="@Icons.LogOut" /> @L["Wyloguj się"]</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </header>

    @if (viewer?.IsSuspended == true)
    {
        <div class="account-banner" role="status">
            <div class="account-banner-inner">
                <Icon Name="@Icons.Pause" />
                <span><strong>@L["Konto zawieszone."]</strong> @L["Możesz przeglądać SansPost, ale publikowanie jest obecnie niedostępne (posty, komentarze, reakcje i zgłoszenia)."]</span>
            </div>
        </div>
    }

    <main id="main" class="app-main" tabindex="-1">
        <CascadingValue Value="viewer">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <EmptyState Title="@L["Coś poszło nie tak"]" HeadingLevel="1" IconName="@Icons.AlertTriangle" Variant="AlertVariant.Danger"
                                Text="@L["Nie udało się wyświetlić tej strony. Spróbuj ponownie — jeśli problem się powtarza, wróć za chwilę."]">
                        <button type="button" class="btn btn-primary" @onclick="Recover"><Icon Name="@Icons.Refresh" /> @L["Spróbuj ponownie"]</button>
                        <a class="btn" href="@SaloonRoutes.Hub">@L["Wróć do odkrywania"]</a>
                    </EmptyState>
                </ErrorContent>
            </ErrorBoundary>
        </CascadingValue>
    </main>

    @* Radio w Saloonie: mini-player żyje w layoucie, więc przetrwa każdą nawigację po aplikacji. *@
    <MiniPlayer />

    <footer class="app-footer">
        <div class="app-footer-inner">
            <span>@L["SansPost · otwarta przestrzeń rozmów · projekt portfolio działający na żywo"]</span>
            <span>@L["Masz uwagi?"] <a href="@CategoryMeta.Url(PostCategory.Feedback)">@L["Napisz w kategorii Feedback"]</a></span>
        </div>
    </footer>

    <nav class="bottom-nav" aria-label="@L["Nawigacja"]">
        <NavLink href="@SaloonRoutes.Hub"><Icon Name="@Icons.Compass" Size="22" /><span>@L["Odkrywaj"]</span></NavLink>
        <NavLink href="/search"><Icon Name="@Icons.Search" Size="22" /><span>@L["Szukaj"]</span></NavLink>
        <NavLink href="@(viewer is null ? "/login?returnUrl=%2Fnew" : "/new")" class="bottom-nav-primary">
            <span class="bubble"><Icon Name="@Icons.Plus" Size="20" StrokeWidth="2.2" /></span><span>@L["Nowy post"]</span>
        </NavLink>
        <NavLink href="/categories"><Icon Name="@Icons.Grid" Size="22" /><span>@L["Kategorie"]</span></NavLink>
        @if (viewer is null)
        {
            <NavLink href="/login"><Icon Name="@Icons.LogIn" Size="22" /><span>@L["Zaloguj"]</span></NavLink>
        }
        else
        {
            <NavLink href="/me"><Icon Name="@Icons.User" Size="22" /><span>@L["Konto"]</span></NavLink>
        }
    </nav>

    <ToastHost />
</div>

@code {
    private ViewerContext? viewer;
    private ErrorBoundary? errorBoundary;
    private string headerQuery = "";
    private bool menuOpen;

    private string LoginHref
    {
        get
        {
            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            return path.StartsWith("/login", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/register", StringComparison.OrdinalIgnoreCase)
                ? "/login"
                : UiText.LoginUrl(path);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        L.Changed += OnLanguageChanged;
        await LoadViewerAsync(AuthProvider.GetAuthenticationStateAsync());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Znacznik "circuit podłączony" — po pierwszym interaktywnym renderze (DOM jest już stabilny).
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("sansPost.markInteractive");
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task LoadViewerAsync(Task<AuthenticationState> stateTask)
    {
        var user = (await stateTask).User;
        if (user.GetUserId() is not int userId)
        {
            // Zalogowany widok stał się anonimowy bez wylogowania (rewalidacja circuitu: nowa AuthVersion) —
            // jasny komunikat zamiast cichego przejścia w tryb gościa.
            if (viewer is not null)
            {
                viewer = null;
                EndSession();
            }

            return;
        }

        // Tożsamość od razu (render bez czekania na bazę), status konta dociągany z bazy.
        viewer = new ViewerContext(userId, user.Identity?.Name ?? "", user.IsInRole(nameof(UserRole.Admin)), viewer?.UserId == userId ? viewer.Status : null);

        try
        {
            var status = await Ui.Run((IUserService s) => s.GetAccountStatusAsync(userId));
            if (status is null or AccountStatus.Banned)
            {
                // Zablokowane konto nie utrzymuje sesji UI: pełne przeładowanie → walidacja cookie (AuthVersion) → wylogowanie.
                EndSession();
                return;
            }

            viewer = viewer with { Status = status };
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Nie udało się odczytać statusu konta.");
        }
    }

    private void EndSession()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!path.StartsWith("/login", StringComparison.OrdinalIgnoreCase))
            Navigation.NavigateTo("/login?ended=1", forceLoad: true);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        menuOpen = false;
        errorBoundary?.Recover();
        _ = InvokeAsync(async () =>
        {
            // Świeży status przy każdej nawigacji (zawieszenie/przywrócenie widoczne bez przeładowania).
            await LoadViewerAsync(AuthProvider.GetAuthenticationStateAsync());
            StateHasChanged();
        });
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> stateTask)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadViewerAsync(stateTask);
            StateHasChanged();
        });
    }

    private void SubmitSearchAsync()
    {
        var query = headerQuery.Trim();
        Navigation.NavigateTo(query.Length == 0 ? "/search" : $"/search?q={Uri.EscapeDataString(query)}");
        headerQuery = "";
    }

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void CloseMenu() => menuOpen = false;

    private async Task MenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
            return;

        menuOpen = false;
        await JS.InvokeVoidAsync("sansPost.focusSelector", "#user-menu-trigger");
    }

    private void Recover() => errorBoundary?.Recover();

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        L.Changed -= OnLanguageChanged;
    }

    // Layout nie dziedziczy LocalizedComponentBase (LayoutComponentBase) — odświeża się sam po zmianie języka.
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
}
