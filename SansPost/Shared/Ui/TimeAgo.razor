@* Czas względny ("3 godziny temu"); pełna data w title i w atrybucie datetime (dla czytników i maszyn). *@
<time class="@Class" datetime="@Value.ToString("o")" title="@UiText.FullDate(Value)">@Prefix@UiText.Relative(Value)</time>

@code {
    [Parameter, EditorRequired] public DateTime Value { get; set; }
    [Parameter] public string? Prefix { get; set; }
    [Parameter] public string? Class { get; set; }
}
