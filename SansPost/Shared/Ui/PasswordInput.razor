@* Pole hasła z przełącznikiem widoczności (aria-pressed). Działa w natywnym formularzu (atrybut name). *@
<div class="input-with-action">
    <input class="input" type="@(visible ? "text" : "password")" id="@Id" name="@Name" autocomplete="@Autocomplete"
           minlength="@MinLength" maxlength="@MaxLength" required aria-invalid="@(Invalid ? "true" : null)"
           aria-describedby="@DescribedBy" />
    <button type="button" class="btn btn-ghost btn-icon btn-sm input-action" aria-controls="@Id"
            aria-pressed="@(visible ? "true" : "false")" aria-label="Pokaż hasło" @onclick="() => visible = !visible">
        <Icon Name="@(visible ? Icons.EyeOff : Icons.Eye)" />
    </button>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public int? MinLength { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public string? DescribedBy { get; set; }

    private bool visible;
}
