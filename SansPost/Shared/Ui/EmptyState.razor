@* Wspólny wzorzec stanów: pusto, błąd, brak dostępu, nie znaleziono, limit. Kontekstowy tekst podaje strona. *@
<div class="state @VariantClass @(Plain ? "state-plain" : "") @Class" role="@(Variant == AlertVariant.Danger ? "alert" : null)">
    <span class="state-icon"><Icon Name="@IconName" Size="24" /></span>
    @switch (HeadingLevel)
    {
        case 1: <h1 class="state-title">@Title</h1> break;
        case 2: <h2 class="state-title">@Title</h2> break;
        default: <p class="state-title">@Title</p> break;
    }
    @if (!string.IsNullOrEmpty(Text))
    {
        <p class="state-text">@Text</p>
    }
    @if (ChildContent is not null)
    {
        <div class="state-actions">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Text { get; set; }
    [Parameter] public string IconName { get; set; } = Icons.Signpost;
    [Parameter] public AlertVariant Variant { get; set; } = AlertVariant.Info;
    [Parameter] public int HeadingLevel { get; set; }
    [Parameter] public bool Plain { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string VariantClass => Variant switch
    {
        AlertVariant.Danger => "state-danger",
        AlertVariant.Warning => "state-warning",
        _ => ""
    };
}
