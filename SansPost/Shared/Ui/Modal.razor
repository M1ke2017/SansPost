@implements IAsyncDisposable
@inject IJSRuntime JS

@* Natywny <dialog> (showModal): pułapka fokusu, Escape, inert tło i powrót fokusu do wyzwalacza zapewnia przeglądarka.
   Treść renderowana tylko gdy otwarty — każde otwarcie zaczyna od czystego stanu. Pierwsze pole: atrybut autofocus. *@
<dialog class="dialog @Class" @ref="element" aria-labelledby="@titleId">
    @if (isOpen)
    {
        <div class="dialog-header">
            <div class="dialog-heading">
                @if (Kicker is not null)
                {
                    <p class="dialog-kicker">@L[Kicker]</p>
                }
                <h2 class="dialog-title" id="@titleId">@L[Title]</h2>
            </div>
            <button type="button" class="btn btn-ghost btn-icon" aria-label="@L["Zamknij okno"]" @onclick="CloseRequestedAsync">
                <Icon Name="@Icons.X" />
            </button>
        </div>
        <div class="dialog-body">
            @ChildContent
        </div>
        @if (Footer is not null)
        {
            <div class="dialog-footer">@Footer</div>
        }
    }
</dialog>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    // Wariant wyglądu (np. karta Saloonu na Entrance) i mały nagłówek nad tytułem.
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Kicker { get; set; }

    // Wywoływane po każdym zamknięciu (przycisk, Escape, klik w tło) — np. powrót kamery sali do kadru głównego.
    [Parameter] public EventCallback OnClosed { get; set; }

    // Tryb zarządzany: Escape, "Zamknij" i klik w tło nie zamykają okna same, tylko trafiają tutaj
    // ("escape" | "button" | "backdrop") — właściciel decyduje (np. BAR: Escape cofa o poziom, na Karcie rozmów zamyka).
    [Parameter] public EventCallback<string> OnDismiss { get; set; }

    private readonly string titleId = "dialog-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference element;
    private DotNetObjectReference<Modal>? selfReference;
    private bool isOpen;
    private bool showPending;
    // Numer otwarcia: "zamknięte" z przeglądarki przychodzi asynchronicznie — spóźnione powiadomienie o zamknięciu
    // poprzedniego otwarcia nie może zamknąć treści okna otwartego ponownie w międzyczasie.
    private int generation;

    public bool IsOpen => isOpen;

    public Task ShowAsync()
    {
        isOpen = true;
        showPending = true;
        generation++;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public async Task CloseAsync()
    {
        if (!isOpen)
            return;

        // Zamknięcie natywne wywoła zdarzenie "close" → OnDialogClosed.
        await JS.InvokeVoidAsync("sansPost.closeDialog", element);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!showPending)
            return;

        showPending = false;
        selfReference ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("sansPost.showDialog", element, selfReference, OnDismiss.HasDelegate, generation);
    }

    private Task CloseRequestedAsync() => OnDismiss.HasDelegate ? OnDismiss.InvokeAsync("button") : CloseAsync();

    [JSInvokable]
    public Task OnDialogDismiss(string reason) => OnDismiss.InvokeAsync(reason);

    [JSInvokable]
    public async Task OnDialogClosed(int closedGeneration)
    {
        if (!isOpen || closedGeneration != generation)
            return;

        isOpen = false;
        StateHasChanged();
        await OnClosed.InvokeAsync();
    }

    public ValueTask DisposeAsync()
    {
        selfReference?.Dispose();
        return ValueTask.CompletedTask;
    }
}
