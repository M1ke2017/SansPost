@* Licznik znaków. Twardy limit wymusza maxlength pola; licznik tylko informuje (od 90% w kolorze + tekst).
   Podczas pisania aktualizuje go przeglądarka (sanspost.js, zdarzenie input pola "For") — bez round-tripu do serwera
   na każdy znak; serwer renderuje wartość po zdarzeniu change i przy walidacji. *@
<span class="counter @StateClass" data-counter-for="@For" data-max="@Max"><span data-counter-value>@UiText.Number(Length)</span> / @UiText.Number(Max)<span class="visually-hidden"> znaków</span></span>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter, EditorRequired] public int Max { get; set; }

    // Id pola, którego długość pokazuje licznik.
    [Parameter] public string? For { get; set; }

    private int Length => Value?.Length ?? 0;

    private string StateClass => Length > Max ? "is-over" : Length >= Max * 0.9 ? "is-near" : "";
}
