@inject UiServices Ui
@inject ILogger<AliasPicker> Logger

@* Przydomek z zatwierdzonego słownika (WesternAliases) — nie da się go wpisać ręcznie. Pole ukryte jest tylko nośnikiem:
   serwer i tak weryfikuje, że to jeden z przydomków SansPost. Używany przez /register i kartę przybysza na Entrance. *@
<div class="field alias-field">
    <span class="field-label" id="alias-label">Twój przydomek</span>
    <div class="alias-box">
        <output class="alias-value" id="alias-value" aria-labelledby="alias-label" aria-live="polite">@Alias</output>
        <button type="button" class="btn btn-sm" @onclick="RerollAsync"
                aria-describedby="alias-hint" aria-busy="@(rolling ? "true" : "false")">
            <Icon Name="@Icons.Refresh" Size="16" /> Losuj inny
        </button>
    </div>
    <span class="field-hint" id="alias-hint">Przydomki pochodzą ze słownika SansPost — widoczne publicznie i stałe po rejestracji.</span>
    <input type="hidden" name="Username" value="@Alias" />
</div>

@code {
    [Parameter] public string? Alias { get; set; }
    [Parameter] public EventCallback<string?> AliasChanged { get; set; }

    private bool rolling;

    // "Losuj inny": nowa propozycja z tego samego słownika. Niczego nie tworzy ani nie rezerwuje.
    public async Task RerollAsync()
    {
        // Blokada logiczna zamiast disabled: przycisk zachowuje fokus (Enter/Spacja działają dalej),
        // a trwające losowanie nie uruchamia drugiego żądania. Nowy przydomek ogłasza <output aria-live>.
        if (rolling)
            return;

        rolling = true;
        try
        {
            for (var attempt = 0; attempt < 3; attempt++)
            {
                var next = await Ui.Run((IAliasGenerator s) => s.SuggestAsync());
                if (next is not null && next != Alias)
                {
                    Alias = next;
                    await AliasChanged.InvokeAsync(next);
                    break;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Nie udało się wylosować przydomka.");
        }
        finally
        {
            rolling = false;
        }
    }
}
