@inject UiServices Ui
@inject IJSRuntime JS
@inject ILogger<FeedList> Logger

@* Lista postów z paginacją keyset ("Załaduj więcej" kontynuuje kursor z serwera — bez pobierania wszystkiego).
   Stany: szkielet przy pierwszym wczytaniu, pusty (kontekstowy), błąd z ponowieniem. *@
@if (isLoading && items.Count == 0)
{
    <PostCardSkeleton Count="3" />
}
else if (errorMessage is not null && items.Count == 0)
{
    <EmptyState Title="Nie udało się wczytać postów" Text="@L.Text(errorMessage)" IconName="@Icons.AlertTriangle" Variant="AlertVariant.Danger">
        <button type="button" class="btn" @onclick="ReloadAsync"><Icon Name="@Icons.Refresh" /> @L["Spróbuj ponownie"]</button>
    </EmptyState>
}
else if (items.Count == 0)
{
    @if (Empty is not null)
    {
        @Empty
    }
    else
    {
        <EmptyState Title="Nie ma jeszcze postów" Text="Gdy ktoś coś opublikuje, pojawi się tutaj." />
    }
}
else
{
    <ul class="post-list @(Compact ? "is-compact" : "")" aria-label="@L[Label]">
        @foreach (var item in items)
        {
            <li @key="item.Id" id="@($"feed-item-{item.Id}")">
                <PostCard Post="item" ShowAuthor="ShowAuthor" HeadingLevel="HeadingLevel" Compact="Compact" />
            </li>
        }
    </ul>

    @if (errorMessage is not null)
    {
        <Alert Variant="AlertVariant.Danger" Class="load-more">@L.Text(errorMessage)</Alert>
    }

    <LoadMore HasMore="nextCursor is not null" IsLoading="isLoading" OnClick="LoadMoreAsync" Label="Pokaż starsze"
              Status="@status" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    [Parameter] public PostCategory? Category { get; set; }
    [Parameter] public PostSort Sort { get; set; } = PostSort.Newest;
    [Parameter] public int? AuthorId { get; set; }
    [Parameter] public int? ExcludePostId { get; set; }
    [Parameter] public bool ShowAuthor { get; set; } = true;
    [Parameter] public int HeadingLevel { get; set; } = 2;
    [Parameter] public string Label { get; set; } = "Posty";
    [Parameter] public RenderFragment? Empty { get; set; }
    [Parameter] public bool Compact { get; set; }

    private readonly List<PostCardModel> items = new();
    private string? nextCursor;
    private bool isLoading;
    private string? errorMessage;
    private string? status;
    private (PostCategory?, PostSort, int?) loadedFor;
    private bool hasLoaded;
    private int? focusAfterRender;

    protected override async Task OnParametersSetAsync()
    {
        var key = (Category, Sort, AuthorId);
        if (hasLoaded && key == loadedFor)
            return;

        loadedFor = key;
        hasLoaded = true;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        items.Clear();
        nextCursor = null;
        status = null;
        await LoadAsync();
    }

    private async Task LoadMoreAsync()
    {
        var before = items.Count;
        await LoadAsync();

        var added = items.Count - before;
        if (added > 0)
        {
            status = $"Wczytano {UiText.Posts(L, added)}. Razem: {UiText.Number(L, items.Count)}.";

            // Przycisk zniknął (koniec listy) — fokus na pierwszy nowy post, żeby nie przepadł na <body>.
            if (nextCursor is null)
                focusAfterRender = items[before].Id;
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var viewerId = (await AuthState).User.GetUserId();
            var result = await Ui.Run((IPostService s) => s.GetFeedAsync(new PostFeedQuery
            {
                Category = Category,
                Sort = Sort,
                AuthorId = AuthorId,
                Cursor = nextCursor
            }, viewerId));

            if (!result.Succeeded)
            {
                errorMessage = UiErrors.Describe(result);
                return;
            }

            var fresh = result.Value!.Items
                .Where(p => p.Id != ExcludePostId && items.All(existing => existing.Id != p.Id))
                .Select(PostCardModel.From)
                .ToList();
            items.AddRange(fresh);
            nextCursor = result.Value.NextCursor;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd wczytywania feedu.");
            errorMessage = UiErrors.Generic;
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusAfterRender is int id)
        {
            focusAfterRender = null;
            await JS.InvokeVoidAsync("sansPost.focusSelector", $"#feed-item-{id} .post-card-title a");
        }
    }
}
