@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject UiServices Ui
@inject ILogger<SaloonHall> Logger

@* Saloon Main Hall 3D (Sprint 15): sala Three.js (js/saloon3d.js) z czterema strefami. Canvas jest tylko obrazem sali —
   każda strefa ma prawdziwy przycisk HTML (Tab, Enter/Spacja, fokus widoczny), a treść zostaje HTML-em/Blazorem:
   BAR otwiera istniejący feed w panelu (natywny <dialog>: Escape, "Zamknij", powrót fokusu), tablica Wanted (Sprint 17)
   — najciekawsze rozmowy tygodnia w tym samym oknie, Kącik muzyczny (Sprint 18) — radio country, Stół gry (Sprint 19)
   — pojedynek "Śladem Rewolwerowca" na silniku F#.
   Do decyzji renderera sala jest w stanie Pending (warstwa z logo, bez klasycznego feedu); OnDecided("3d" | "css")
   dostaje strona /saloon dopiero wtedy, gdy pierwsza klatka jest narysowana albo zapadła decyzja fallback. *@
<section class="saloon-hall @(ready ? "is-ready" : "")" aria-labelledby="hall-title" aria-describedby="hall-description">
    <h1 id="hall-title" class="visually-hidden">@L["Saloon SansPost — sala główna"]</h1>
    <p id="hall-description" class="visually-hidden">@L["Wybierz miejsce w sali: bar z rozmowami, tablicę Wanted, stół gry albo kącik muzyczny."]</p>

    <div class="hall-3d" @ref="host" aria-hidden="true"></div>
    <div class="hall-vignette" aria-hidden="true"></div>

    @* Desktop: nagłówek aplikacji jest nad salą ukryty (sala to główny widok). Dyskretny narożnik zostawia tylko
       naprawdę globalne akcje: wyjście, motyw i konto. Wyszukiwanie i kategorie trafią do BAR (rozmowy), sala ma własną
       nawigację stref. Na mobile zostaje zwykły nagłówek. *@
    <nav class="hall-corner" aria-label="SansPost">
        <a class="hall-corner-brand" href="/" title="@L["SansPost — wejście do Saloonu"]">
            <svg width="20" height="20" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                <circle cx="16" cy="13.5" r="6" fill="currentColor" />
                <path d="M4 21.5h24M9 26h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none" />
            </svg>
            <span>Sans<span class="brand-post">Post</span></span>
        </a>
        <span class="hall-corner-actions">
            <LanguageToggle /><ThemeToggle />
            @if (Viewer is null)
            {
                @* Karta logowania nad salą (te same formularze co Entrance i BAR) — bez klasycznej strony i bez otwierania baru. *@
                <button type="button" id="hall-corner-login" class="hall-corner-link hall-corner-text" aria-haspopup="dialog"
                        @onclick="() => loginCard!.ShowAsync()">@L["Zaloguj się"]</button>
            }
            else
            {
                <a class="hall-corner-link" href="/me" aria-label="@L.Format("Moje konto ({0})", Viewer.Username)" title="@L["Moje konto"]"><Icon Name="@Icons.User" Size="18" /></a>
            }
        </span>
    </nav>

    @* Pasek stref: jedyny zestaw przycisków stref (klawiatura, czytniki, dotyk). Desktop: pełny przy pierwszym wejściu
       w sesji, po pierwszym wyborze strefy kompaktowy (pełny przy wskazaniu/fokusie). Mobile: zawsze pełny, przyklejony
       u dołu. Obiekty i szyldy w scenie (canvas) prowadzą do tego samego SelectZoneAsync. *@
    <nav class="hall-zones @(helperCompact ? "is-compact" : "")" aria-label="@L["Strefy Saloonu"]" @ref="zonesElement">
        @if (!helperCompact)
        {
            <p class="hall-zones-caption">@L["Wybierz miejsce — w sali albo tutaj"]</p>
        }
        @foreach (var zone in Zones)
        {
            <button type="button" class="hall-zone @(zone.Id == "bar" ? "is-primary" : "")" data-zone="@zone.Id"
                    aria-haspopup="dialog" aria-describedby="@(zone.Id == "game" && championText is not null ? "hall-champion" : null)"
                    @onclick="() => SelectZoneAsync(zone.Id)">
                <span class="hall-zone-name">@L[zone.Name]</span>
                <span class="hall-zone-hint">@L[zone.Hint]</span>
            </button>
        }
        @* Plakietka Mistrza Stołu w scenie (canvas) — ten sam tekst dla czytnika jako opis strefy "Stół gry". *@
        @if (championText is not null)
        {
            <span class="visually-hidden" id="hall-champion">@championText</span>
        }
    </nav>

    @* Pending: ciepłe wnętrze + logo do chwili, gdy pierwsza klatka sali jest gotowa (potem krótkie przenikanie). *@
    <div class="hall-pending" role="status">
        <span class="hall-pending-kicker" aria-hidden="true">Saloon</span>
        <span class="hall-pending-logo" aria-hidden="true">SansPost</span>
        <span class="hall-pending-text">@L["Zapalamy lampy w Saloonie…"]</span>
    </div>
</section>

@* Logowanie i rejestracja rozpoczęte w sali (narożnik): karty z Entrance nad sceną. Po sukcesie sala ładuje się od nowa
   z nowym cookie — nadal Main Hall, bar zamknięty. Zamknięcie karty: fokus wraca na "Zaloguj się". *@
@if (Viewer is null)
{
    <SaloonLoginCard @ref="loginCard" OnSignedIn="SignedInFromCornerAsync" OnSwitchToRegister="() => registerCard!.ShowAsync()"
                     OnClosed="CornerCardClosedAsync" />
    <SaloonRegisterCard @ref="registerCard" OnSignedIn="SignedInFromCornerAsync" OnSwitchToLogin="() => loginCard!.ShowAsync()"
                        OnRegisteredWithoutSignIn="() => loginCard!.ShowAsync(afterRegistration: true)" OnClosed="CornerCardClosedAsync" />
}

@* BAR: Karta rozmów i jej poziomy (stan w adresie /saloon?bar=…) oraz tablica Wanted (/saloon?wanted=…) — to samo okno.
   Kamera podchodzi do strefy, zanim okno się otworzy. *@
<BarConversationPanel @ref="barPanel" State="Bar" Featured="Featured" Categories="Categories" OnClosed="OnBarClosedAsync"
                      OnWantedLoaded="ShowWantedOnBoardAsync" />

@code {
    [CascadingParameter] private ViewerContext? Viewer { get; set; }

    // Stan okna sali z adresu — BAR albo tablica Wanted (null = okno zamknięte) i dane Karty rozmów, które strona
    // /saloon ma już wczytane.
    [Parameter] public BarState? Bar { get; set; }
    [Parameter] public PostCardModel? Featured { get; set; }
    [Parameter] public IReadOnlyList<CategorySummaryResponse>? Categories { get; set; }

    // "/saloon?scene=3d" — sala bez kryteriów wydajności (diagnostyka, testy).
    [Parameter] public bool Force { get; set; }

    // Przeglądarka wybrała już wcześniej 3D (ScenePreference) — bez próby płynności.
    [Parameter] public bool Known3d { get; set; }

    [Parameter] public EventCallback<string> OnDecided { get; set; }

    private sealed record Zone(string Id, string Name, string Hint);

    private sealed record RendererDecision(string Renderer, string Reason);

    private static readonly Zone[] Zones =
    {
        new("bar", "Bar", "rozmowy"),
        new("wanted", "Tablica Wanted", "najlepsze rozmowy"),
        new("game", "Stół gry", "pojedynek"),
        new("music", "Kącik muzyczny", "radio country")
    };

    private ElementReference host;
    private ElementReference zonesElement;
    private IJSObjectReference? module;
    private DotNetObjectReference<SaloonHall>? self;
    private BarConversationPanel? barPanel;
    private SaloonLoginCard? loginCard;
    private SaloonRegisterCard? registerCard;
    private bool ready;
    private bool busy;
    // Onboarding paska stref: po pierwszym świadomym wyborze strefy w sesji pasek na desktopie staje się kompaktowy.
    private bool helperCompact;
    // Strefa otwarta kliknięciem w scenę — po powrocie fokus nie jest przerzucany na przycisk paska.
    private bool openedFromCanvas;
    // Adres zmienił stan BAR (otwarcie, zamknięcie, "wstecz") — okno i kamera dostosowują się po renderze.
    private bool barDirty;
    private bool barSyncing;
    private int barOpenings;
    // Strefa, przy której stoi otwarte okno ("bar" / "wanted") — kamera i fokus po zamknięciu.
    private string openZone = "bar";
    // Plakaty pokazane na tablicy 3D (PostId, przydomek, tytuł) — bez ponownego rysowania tekstury przy tym samym wyniku.
    private string? boardKey;

    protected override void OnParametersSet() => barDirty = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (ready && barDirty)
                await SyncBarAsync();
            return;
        }

        RendererDecision decision;
        bool restoreBar = false;
        try
        {
            self = DotNetObjectReference.Create(this);
            var arrived = await JS.InvokeAsync<bool>("sansPost.takeDoorArrival");
            // Wejście prosto do baru (link, "wstecz" z posta) — kamera od razu przy barze, okno po pierwszej klatce.
            restoreBar = Bar is not null;
            if (restoreBar)
                openZone = Bar!.Zone;
            helperCompact = await JS.InvokeAsync<bool>("sansPost.hallOnboarded", false);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/saloon3d.js");
            decision = await module.InvokeAsync<RendererDecision>("init", host,
                new { force = Force, known3d = Known3d, zones = zonesElement, dotnet = self, arrived, area = restoreBar ? openZone : null, labels = SceneLabels() });
            sceneLanguage = L.Language;
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (JSException)
        {
            decision = new RendererDecision("css", "init-failed");
        }

        if (decision.Reason == "cancelled")
            return;

        ready = decision.Renderer == "3d";
        await OnDecided.InvokeAsync(decision.Renderer);
        if (!ready)
            return;

        barDirty = false;
        StateHasChanged();
        // Język zmieniony w trakcie startu sceny (napisy narysowane jeszcze w poprzednim) — przerysowanie teraz.
        if (sceneLanguage != L.Language)
            await OnLanguageChangedAsync();
        if (restoreBar)
            await barPanel!.ShowAsync();

        // Tablica 3D: aktualny Most Wanted na głównym plakacie (jedno zapytanie po narysowaniu sali; okno Wanted
        // odświeża go przy każdym otwarciu). Gdy tablica jest otwarta od razu, wynik przyjdzie z okna.
        if (Bar?.IsWanted != true)
            await LoadBoardAsync();
        await LoadChampionAsync();
    }

    // Mistrz Stołu (Sprint 21): plakietka pod szyldem stołu — ranking z pamięci podręcznej serwisu (bez zapytania na wejście).
    private string? championText;

    private sealed record ChampionPlaque(string? Title, string? Alias, int Stars, string? Empty);

    private TableChampion? champion;
    private bool championLoaded;

    // Język, w którym scena narysowała napisy przy starcie.
    private string? sceneLanguage;

    private async Task LoadChampionAsync()
    {
        try
        {
            champion = (await Ui.Run((DuelStandingsService s) => s.GetStandingsAsync())).Champion;
            championLoaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Nie udało się wczytać Mistrza Stołu do sceny.");
            return;
        }
        await ShowChampionAsync();
    }

    // Plakietka w scenie i opis dla czytnika — w bieżącym języku (po zmianie języka bez ponownego zapytania).
    private async Task ShowChampionAsync()
    {
        championText = champion is null ? L["Stół czeka na pierwszego mistrza."] : L.Format("Mistrz Stołu: {0}, {1} ★.", champion.Alias, champion.Stars);
        StateHasChanged();
        if (module is null)
            return;
        try
        {
            await module.InvokeVoidAsync("setChampion", champion is null
                ? new ChampionPlaque(null, null, 0, L["Stół czeka na pierwszego mistrza."])
                : new ChampionPlaque(L["MISTRZ STOŁU"], champion.Alias, champion.Stars, null));
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    // Napisy malowane w scenie 3D (szyldy, tablica Wanted, rekwizyty stołu) w języku interfejsu.
    private object SceneLabels() => new
    {
        bar = L["BAR"], game = L["STÓŁ GRY"], music = L["MUZYKA"],
        wantedFor = L["za rozmowę, która rozpaliła Saloon"], wantedEmpty = L["Tablica czeka na pierwszą rozmowę."],
        wantedTitle = L["POSZUKIWANI"], wantedMost = L["NAJBARDZIEJ|POSZUKIWANY"], wantedSmall = L["POSZUKIWANY"],
        round = L["RUNDA"], rulesTitle = L["ŚLADEM|REWOLWEROWCA"], rules = L["3 prestiżu · 1 nabój · 12 rund"],
        shoot = L["Strzał"], dodge = L["Unik"], reload = L["Przeładowanie"], block = L["Blok"], taunt = L["Prowokacja"],
        history = L["Tak wyglądaliśmy, gdy zaczynaliśmy."]
    };

    // Zmiana języka (Sprint 22): ta sama scena — przerysowanie tekstur z napisami i plakietki Mistrza Stołu.
    protected override async Task OnLanguageChangedAsync()
    {
        if (module is null || !ready)
            return;
        try
        {
            await module.InvokeVoidAsync("setLanguage", SceneLabels());
            sceneLanguage = L.Language;
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (JSException)
        {
            return;
        }
        if (championLoaded)
            await ShowChampionAsync();
    }

    private async Task LoadBoardAsync()
    {
        IReadOnlyList<WantedPosterResponse> posters;
        try
        {
            posters = await Ui.Run((IPostService s) => s.GetWantedAsync());
        }
        catch (Exception ex)
        {
            // Tablica w scenie to dodatek — sala działa bez niego (zostają puste listy gończe).
            Logger.LogWarning(ex, "Nie udało się wczytać plakatów tablicy Wanted do sceny.");
            return;
        }
        await ShowWantedOnBoardAsync(posters);
    }

    // Plakaty na tablicy 3D: jedna tekstura (canvas) przerysowana tylko przy zmianie wyniku.
    private async Task ShowWantedOnBoardAsync(IReadOnlyList<WantedPosterResponse> posters)
    {
        var shownPosters = posters.Take(5).Select(p => new { alias = p.Alias, title = p.Title }).ToList();
        var key = string.Join("\u0001", posters.Take(5).Select(p => $"{p.PostId}:{p.Alias}:{p.Title}"));
        if (module is null || key == boardKey)
            return;
        boardKey = key;
        try
        {
            await module.InvokeVoidAsync("setWanted", shownPosters);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    // Okno BAR nadąża za adresem: otwarcie (kamera podchodzi, potem Karta rozmów) albo zamknięcie (kamera wraca).
    private async Task SyncBarAsync()
    {
        if (barSyncing)
            return;

        barSyncing = true;
        try
        {
            while (barDirty)
            {
                barDirty = false;
                if (Bar is not null && !barPanel!.IsOpen)
                {
                    barOpenings++;
                    busy = true;
                    openZone = Bar.Zone;
                    if (module is not null)
                        await module.InvokeVoidAsync("focusArea", openZone);
                    busy = false;
                    if (Bar is not null)
                        await barPanel.ShowAsync();
                    else
                        await ResetViewAsync();   // "wstecz" w trakcie podejścia kamery — sala wraca do kadru głównego
                }
                else if (Bar is null && barPanel!.IsOpen)
                {
                    await barPanel.CloseAsync();
                }
                else if (Bar is not null && Bar.Zone != openZone)
                {
                    // Okno zostaje, zmienia się strefa (np. adres BAR ↔ Wanted wpisany ręcznie) — kamera do nowej strefy.
                    openZone = Bar.Zone;
                    if (module is not null)
                        await module.InvokeVoidAsync("focusArea", openZone);
                }
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        finally
        {
            busy = false;
            barSyncing = false;
        }
    }

    // Kliknięcie w strefę na canvas (raycasting w saloon3d.js) — ta sama ścieżka co przycisk HTML.
    [JSInvokable]
    public Task SelectZone(string zone) => SelectZoneAsync(zone, fromCanvas: true);

    private async Task SelectZoneAsync(string zoneId, bool fromCanvas = false)
    {
        if (!ready || busy || barPanel?.IsOpen == true || Bar is not null || Zones.All(z => z.Id != zoneId))
            return;

        // Każda strefa to poziom w historii (/saloon?bar=menu, ?wanted=board, ?music=radio, ?game=table): "wstecz" zamyka
        // go jak Escape. Kamera i okno — SyncBarAsync. Przycisk paska, szyld i obiekt w scenie — ta sama ścieżka.
        openedFromCanvas = fromCanvas;
        await CompleteOnboardingAsync();
        BarNavigation.Push(Navigation, zoneId switch
        {
            "bar" => BarState.Menu,
            "wanted" => BarState.Wanted,
            "music" => BarState.Music,
            _ => BarState.Game
        });
    }

    // Nowe cookie wymaga nowego circuitu: /saloon od nowa (sala bez otwartego baru, już z kontem).
    private void SignedInFromCornerAsync() => Navigation.NavigateTo(SaloonRoutes.Hub, forceLoad: true, replace: true);

    // Karta zamknięta (Escape, "Zamknij", przełączenie na drugą kartę): gdy żadna nie jest otwarta — fokus na "Zaloguj się".
    private async Task CornerCardClosedAsync()
    {
        await Task.Yield();   // przełączenie login ↔ rejestracja: druga karta otwiera się w tym samym kroku
        if (loginCard?.IsOpen == true || registerCard?.IsOpen == true)
            return;
        try
        {
            await JS.InvokeVoidAsync("sansPost.focusSelector", "#hall-corner-login");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task CompleteOnboardingAsync()
    {
        if (helperCompact)
            return;

        helperCompact = true;
        try
        {
            await JS.InvokeAsync<bool>("sansPost.hallOnboarded", true);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    // Okno zamknięte: kamera wraca do kadru głównego, fokus na przycisk strefy, która je otworzyła — BAR albo tablica Wanted
    // (chyba że okno otwarto kliknięciem w scenę).
    // Gdy okno zamknęła sama przeglądarka (adres wciąż z barem) — adres też wraca do sali.
    // Kolejność ma znaczenie: stan sprawdzony przed jakimkolwiek await (w trakcie powrotu kamery bar można otworzyć
    // ponownie — to nowe otwarcie nie może zostać zamknięte), fokus od razu, kamera na końcu.
    private async Task OnBarClosedAsync()
    {
        var urlStillHasBar = Bar is not null;
        var generation = barOpenings;
        var focusBar = !openedFromCanvas;
        openedFromCanvas = false;
        try
        {
            if (focusBar)
                await JS.InvokeVoidAsync("sansPost.focusSelector", $".hall-zone[data-zone='{openZone}']");
            if (urlStillHasBar)
                await BarNavigation.CloseAsync(Navigation, JS);
        }
        catch (JSDisconnectedException)
        {
        }

        if (generation == barOpenings)
            await ResetViewAsync();
    }

    private async Task ResetViewAsync()
    {
        try
        {
            if (module is not null)
                await module.InvokeVoidAsync("resetView");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    // Opuszczenie /saloon (albo fallback na widok klasyczny): pętla, listenery, obserwatory i zasoby WebGL.
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        self?.Dispose();
    }
}
