@* "Karta nowego przybysza" — okno z formularzem SaloonRegisterForm (ten sam formularz co karta w BAR): na Entrance
   (po sukcesie drzwi i /saloon; przy zamkniętej rejestracji "Wejdź jako gość") i w Main Hall 3D (po sukcesie sala od nowa). *@
<Modal @ref="modal" Title="Karta nowego przybysza" Kicker="SansPost Saloon" Class="dialog-card" OnClosed="OnClosed">
    <SaloonRegisterForm OnSignedIn="SignedInAsync" OnRegisteredWithoutSignIn="RegisteredWithoutSignInAsync"
                        OnSwitchToLogin="SwitchAsync" OnGuest="EnterAsGuestAsync" />
</Modal>

@code {
    [Parameter] public EventCallback OnSignedIn { get; set; }
    [Parameter] public EventCallback OnRegisteredWithoutSignIn { get; set; }
    [Parameter] public EventCallback OnSwitchToLogin { get; set; }
    [Parameter] public EventCallback OnGuest { get; set; }

    // Każde zamknięcie okna — np. fokus z powrotem na przycisk w sali.
    [Parameter] public EventCallback OnClosed { get; set; }

    public bool IsOpen => modal?.IsOpen == true;

    private Modal? modal;

    // Treść okna (i sprawdzenie wolnych miejsc) powstaje przy każdym otwarciu od nowa.
    public Task ShowAsync() => modal!.ShowAsync();

    private async Task SignedInAsync(AuthPostResult result)
    {
        await modal!.CloseAsync();
        await OnSignedIn.InvokeAsync();
    }

    private async Task RegisteredWithoutSignInAsync()
    {
        await modal!.CloseAsync();
        await OnRegisteredWithoutSignIn.InvokeAsync();
    }

    private async Task SwitchAsync()
    {
        await modal!.CloseAsync();
        await OnSwitchToLogin.InvokeAsync();
    }

    // Przy zamkniętej rejestracji: Entrance — wejście jako gość; w sali (gość już jest) — tylko zamknięcie karty.
    private async Task EnterAsGuestAsync()
    {
        await modal!.CloseAsync();
        await OnGuest.InvokeAsync();
    }
}
