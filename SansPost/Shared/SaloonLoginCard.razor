@* "Karta powrotu do Saloonu" — okno z formularzem SaloonLoginForm (ten sam formularz co karta w BAR): na Entrance
   (po sukcesie drzwi, potem /saloon) i w Main Hall 3D (po sukcesie sala od nowa, już z kontem). *@
<Modal @ref="modal" Title="Karta powrotu do Saloonu" Kicker="SansPost Saloon" Class="dialog-card" OnClosed="OnClosed">
    <SaloonLoginForm AfterRegistration="registered" OnSignedIn="SignedInAsync" OnSwitchToRegister="SwitchAsync" />
</Modal>

@code {
    [Parameter] public EventCallback OnSignedIn { get; set; }
    [Parameter] public EventCallback OnSwitchToRegister { get; set; }

    // Każde zamknięcie okna (Escape, "Zamknij", sukces, przełączenie) — np. fokus z powrotem na przycisk w sali.
    [Parameter] public EventCallback OnClosed { get; set; }

    public bool IsOpen => modal?.IsOpen == true;

    private Modal? modal;
    private bool registered;

    // Treść okna powstaje przy każdym otwarciu od nowa (Modal) — formularz zaczyna bez błędów i bez stanu "w toku".
    public async Task ShowAsync(bool afterRegistration = false)
    {
        registered = afterRegistration;
        await modal!.ShowAsync();
    }

    private async Task SignedInAsync(AuthPostResult result)
    {
        await modal!.CloseAsync();
        await OnSignedIn.InvokeAsync();
    }

    private async Task SwitchAsync()
    {
        await modal!.CloseAsync();
        await OnSwitchToRegister.InvokeAsync();
    }
}
