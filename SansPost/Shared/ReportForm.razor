@using SansPost.Features.Moderation
@inject IReportService ReportService

@* Minimalny formularz zgłoszenia (bez stylizacji — UI/UX w Sprintach 7–8). *@
@if (!isOpen)
{
    <button type="button" @onclick="() => isOpen = true">Zgłoś</button>
}
else
{
    <div class="report-form">
        <select @bind="reason">
            @foreach (var value in Enum.GetValues<ReportReason>())
            {
                <option value="@value">@value</option>
            }
        </select>
        <input @bind="details" maxlength="@ModerationLimits.DetailsMaxLength" placeholder="Szczegóły (opcjonalnie)" />
        <button type="button" @onclick="SubmitAsync" disabled="@isBusy">Wyślij zgłoszenie</button>
        <button type="button" @onclick="() => isOpen = false">Anuluj</button>
    </div>
}
@if (!string.IsNullOrEmpty(message))
{
    <span>@message</span>
}

@code {
    [Parameter, EditorRequired] public ReportTargetType TargetType { get; set; }
    [Parameter, EditorRequired] public int TargetId { get; set; }
    [Parameter, EditorRequired] public int ReporterUserId { get; set; }

    private bool isOpen;
    private bool isBusy;
    private ReportReason reason = ReportReason.Spam;
    private string details = "";
    private string? message;

    private async Task SubmitAsync()
    {
        isBusy = true;
        var result = await ReportService.CreateAsync(ReporterUserId, new CreateReportRequest
        {
            TargetType = TargetType,
            TargetId = TargetId,
            Reason = reason,
            Details = details
        });
        isBusy = false;

        message = result.Succeeded ? "Dziękujemy — zgłoszenie trafiło do moderacji." : result.Message;
        if (result.Succeeded)
            isOpen = false;
    }
}
