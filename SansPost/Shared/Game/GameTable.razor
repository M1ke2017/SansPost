@implements IAsyncDisposable
@using System.Text.Json
@inject GameSessionService Sessions
@inject IJSRuntime JS
@inject NavigationManager Navigation

@* Stół gry — "Śladem Rewolwerowca" (The Gunslinger's Draw). Sprint 19: trening z manekinem na silniku F# przez serwer.
   Sprint 20: pojedynek 1v1 na żywo — gracze przy stole, wyzwanie, gotowość, ukryte karty, czas rundy, rozłączenia,
   oddanie i rewanż. Jedna ścieżka dla wszystkich akcji: DuelHub (SignalR, przez duel.js) → GameSessionService → silnik F#.
   Komponent tylko pokazuje stan z serwera (DuelSnapshot z widoku gracza — bez ukrytej karty przeciwnika) i przekazuje
   kliknięcia; niczego nie liczy. Zdarzenia z serwera niosą wersję — starszy stan nie nadpisze nowszego.
   Konto zawieszone: stół, zasady i stan własnego pojedynku zostają widoczne, akcje są nieaktywne z wyjaśnieniem. O tym, kto
   może grać, rozstrzyga serwer (wspólna polityka konta); ViewerContext służy tu tylko prezentacji. *@
<div class="game-table">
    <section class="game-intro" aria-labelledby="game-rules-title">
        <p class="game-lede">@L["The Gunslinger's Draw — pojedynek jeden na jeden, 3–5 minut. Bez hazardu i nagród — liczy się przewidywanie przeciwnika."]</p>
        <details class="game-rules" open="@(duel is null)">
            <summary id="game-rules-title">@L["Zasady w skrócie"]</summary>
            <ul>
                <li>@L["Obaj gracze wybierają kartę w ukryciu; karty odsłaniają się jednocześnie."]</li>
                <li>@L["Na start:"] <strong>@L["3 prestiżu"]</strong> @L["i"] <strong>@L["1 nabój"]</strong> @L["(bęben mieści 2)."]</li>
                <li>@L["Kto straci cały prestiż — przegrywa. Po 12 rundach wygrywa więcej prestiżu."]</li>
                <li>@L["Na żywo: runda trwa 15 sekund — brak karty kosztuje 1 prestiżu."]</li>
            </ul>
        </details>
        <p class="game-engine"><Icon Name="@Icons.Cpu" Size="14" /> @L["Silnik: SansPost.Game.Core (F#) — każdą rundę rozstrzyga serwer."]</p>
    </section>

    @if (Viewer is null)
    {
        <div class="game-guest">
            <p>@L["Pojedynek jest przypisany do konta. Zaloguj się, żeby zagrać z innym graczem albo z manekinem treningowym."]</p>
            <div class="cluster">
                <a class="btn btn-primary" href="@UiText.LoginUrl(BarState.Game.Url)">@L["Zaloguj się, aby zagrać"]</a>
                <a class="btn" href="@($"/register?returnUrl={Uri.EscapeDataString(BarState.Game.Url)}")">@L["Załóż konto"]</a>
            </div>
        </div>
        <GameDeck />
    }
    else
    {
        @if (connection is "reconnecting" or "disconnected")
        {
            <p class="game-connection" role="status">
                <Icon Name="@Icons.Refresh" Size="16" />
                @(connection == "reconnecting" ? L["Połączenie ze stołem przerwane — wznawiam…"] : L["Brak połączenia ze stołem gry — ponawiam próbę…"])
            </p>
        }

        @if (duel is null)
        {
            @if (!CanPlay)
            {
                @Restricted
            }
            <GameLobby Players="players" Challenges="challenges" CanPlay="CanPlay" Busy="busy" Note="@note" Error="@error" Standings="standings"
                       OnChallenge="Challenge" OnAccept="Accept" OnReject="Reject" OnCancel="Cancel" OnTraining="StartTraining" />
            <GameDeck />
        }
        else
        {
            <GameBoard Duel="duel" Reveal="reveal" CanPlay="CanPlay" Busy="busy" Pending="@pending" Error="@error" YourStars="@standings?.You.PrestigeStars"
                       RoundDeadline="roundDeadline" GraceDeadline="graceDeadline" ConfirmSurrender="confirmSurrender" Restricted="Restricted"
                       OnPlay="Play" OnReady="Ready" OnSurrender="Surrender" OnSurrenderCancel="() => confirmSurrender = false"
                       OnRematch="Rematch" OnLeave="Leave" OnNewTraining="StartTraining" />
        }
    }
</div>

@code {
    [CascadingParameter] private ViewerContext? Viewer { get; set; }

    private static readonly JsonSerializerOptions Web = new(JsonSerializerDefaults.Web);

    private DotNetObjectReference<GameTable>? self;
    private string connection = "connecting";
    private IReadOnlyList<OnlinePlayer> players = Array.Empty<OnlinePlayer>();
    private StandingsView? standings;
    private readonly List<ChallengeView> challenges = new();
    private DuelSnapshot? duel;
    private RoundResult? reveal;
    private double roundDeadline;
    private double graceDeadline;
    private string? pending;
    private int pendingRound;
    private string? note;
    private string? error;
    private string? lastCode;
    private bool busy;
    private bool confirmSurrender;
    private bool focusCards;
    private bool focusReady;
    private bool refocus;

    // Zawieszenie ustalone przez serwer w trakcie tej wizyty (ViewerContext mógł jeszcze nie wiedzieć).
    private bool restricted;

    private bool CanPlay => Viewer is { CanWrite: true } && !restricted;

    protected override void OnInitialized()
    {
        // Pierwszy obraz (także prerender): trwający albo świeżo zakończony pojedynek; potem stan przejmuje DuelHub.
        if (Viewer is not null && Sessions.GetActive(Viewer.UserId) is { Succeeded: true } active)
        {
            duel = active.Value;
            reveal = duel!.History.LastOrDefault();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Viewer is not null)
        {
            self = DotNetObjectReference.Create(this);
            try
            {
                // Połączenie z hubem i pełny stan — także wznowienie trwającego pojedynku po odświeżeniu strony.
                var state = await JS.InvokeAsync<JsonElement>("sansPostDuel.attach", self);
                if (state.ValueKind == JsonValueKind.Object)
                {
                    ApplyState(state);
                    StateHasChanged();
                }
            }
            catch (JSDisconnectedException)
            {
                return;
            }
        }

        await FocusAsync();
    }

    // ---- Zdarzenia z serwera (duel.js → komponent) ------------------------------------------------------------------

    [JSInvokable]
    public async Task OnHubEvent(string name, JsonElement payload)
    {
        switch (name)
        {
            case "State":
                ApplyState(payload);
                break;
            case DuelEvents.PresenceChanged:
                await RefreshPlayersAsync();
                break;
            case DuelEvents.StandingsChanged:
                await RefreshStandingsAsync();
                break;
            case DuelEvents.ChallengeReceived:
                var alias = payload.GetProperty("challengerAlias").GetString()!;
                Upsert(new ChallengeView(payload.GetProperty("challengeId").GetString()!, "incoming", alias, "pending", Number(payload, "localDeadline")));
                note = L.Format("{0} wyzywa Cię na pojedynek!", alias);
                break;
            case DuelEvents.ChallengeUpdated:
                OnChallengeUpdated(ChallengeOf(payload));
                break;
            case DuelEvents.DuelUpdated:
                ApplyDuel(payload);
                break;
            case DuelEvents.RoundStarted:
                if (ApplyDuel(payload.GetProperty("snapshot")))
                {
                    if (duel!.Round == 1 && duel.History.Count == 0)
                        focusCards = true;
                    else
                        refocus = true;
                }
                break;
            case DuelEvents.RoundResolved:
                if (ApplyDuel(payload.GetProperty("snapshot")))
                    ShowReveal(payload.GetProperty("result"));
                break;
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void OnConnectionChanged(string kind)
    {
        connection = kind;
        StateHasChanged();
    }

    private void ApplyState(JsonElement state)
    {
        players = state.GetProperty("players").Deserialize<List<OnlinePlayer>>(Web) ?? new();
        if (state.TryGetProperty("standings", out var ranking) && ranking.ValueKind == JsonValueKind.Object)
            standings = ranking.Deserialize<StandingsView>(Web);
        challenges.Clear();
        foreach (var challenge in state.GetProperty("challenges").EnumerateArray())
            challenges.Add(ChallengeOf(challenge));

        var current = state.GetProperty("duel");
        if (current.ValueKind != JsonValueKind.Object)
        {
            duel = null;
            return;
        }
        if (duel is not null && current.GetProperty("duelId").GetString() != duel.DuelId)
            duel = null;   // stan serwera ma pierwszeństwo (np. rewanż rozpoczęty w innej karcie)
        ApplyDuel(current);
    }

    // Nowy stan pojedynku z serwera. Starsza wersja tego samego pojedynku albo echo zakończonego (po rewanżu) — pomijane.
    private bool ApplyDuel(JsonElement element)
    {
        if (element.ValueKind != JsonValueKind.Object || element.Deserialize<DuelSnapshot>(Web) is not { } snapshot)
            return false;
        if (duel is not null && snapshot.DuelId == duel.DuelId && snapshot.Version < duel.Version)
            return false;
        if (duel is not null && snapshot.DuelId != duel.DuelId && snapshot.Status == "finished" && duel.Status != "finished")
            return false;

        var entering = duel?.DuelId != snapshot.DuelId;
        duel = snapshot;
        roundDeadline = Number(element, "roundLocalDeadline");
        graceDeadline = element.TryGetProperty("opponent", out var opponent) ? Number(opponent, "graceLocalDeadline") : 0;
        if (snapshot.YourMove is not null || snapshot.Round != pendingRound || snapshot.Status != "in-progress")
            pending = null;
        if (snapshot.Status == "finished")
            confirmSurrender = false;

        if (entering)
        {
            reveal = snapshot.History.LastOrDefault();
            pending = null;
            error = null;
            confirmSurrender = false;
            focusReady = snapshot.Status == "ready-check";
            focusCards = snapshot.Status == "in-progress";
        }
        return true;
    }

    private void ShowReveal(JsonElement element)
    {
        if (element.ValueKind == JsonValueKind.Object && element.Deserialize<RoundResult>(Web) is { } round && (reveal is null || round.Round > reveal.Round))
            reveal = round;
    }

    private void OnChallengeUpdated(ChallengeView challenge)
    {
        if (challenge.Status == "pending")
        {
            Upsert(challenge);
            return;
        }

        challenges.RemoveAll(c => c.ChallengeId == challenge.ChallengeId);
        var alias = challenge.OpponentAlias;
        note = (challenge.Status, challenge.Direction) switch
        {
            ("accepted", "outgoing") => L.Format("{0} przyjmuje wyzwanie!", alias),
            ("rejected", "outgoing") => L.Format("{0} odrzuca wyzwanie.", alias),
            ("expired", "outgoing") => L.Format("Wyzwanie do {0} wygasło bez odpowiedzi.", alias),
            ("cancelled", "incoming") => L.Format("{0} wycofuje wyzwanie.", alias),
            ("expired", "incoming") => L.Format("Wyzwanie od {0} wygasło.", alias),
            ("unavailable", _) => L.Format("Pojedynek z {0} nie doszedł do skutku — gracz jest już niedostępny.", alias),
            _ => note
        };
    }

    private void Upsert(ChallengeView challenge)
    {
        challenges.RemoveAll(c => c.ChallengeId == challenge.ChallengeId);
        challenges.Add(challenge);
    }

    private static ChallengeView ChallengeOf(JsonElement element) => new(
        element.GetProperty("challengeId").GetString()!,
        element.GetProperty("direction").GetString()!,
        element.GetProperty("opponentAlias").GetString()!,
        element.GetProperty("status").GetString()!,
        Number(element, "localDeadline"));

    private static double Number(JsonElement element, string name) =>
        element.ValueKind == JsonValueKind.Object && element.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.Number ? value.GetDouble() : 0;

    private async Task RefreshPlayersAsync()
    {
        try
        {
            var list = await JS.InvokeAsync<JsonElement>("sansPostDuel.invoke", "GetPlayers");
            if (list.ValueKind == JsonValueKind.Array)
                players = list.Deserialize<List<OnlinePlayer>>(Web) ?? new();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    // Ranking po zapisanym wyniku PvP (zdarzenie StandingsChanged) — Top 10, Mistrz Stołu, własne gwiazdki.
    private async Task RefreshStandingsAsync()
    {
        try
        {
            var view = await JS.InvokeAsync<JsonElement>("sansPostDuel.invoke", "GetStandings");
            if (view.ValueKind == JsonValueKind.Object && view.TryGetProperty("top", out _))
                standings = view.Deserialize<StandingsView>(Web);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    // ---- Akcje gracza (komponent → duel.js → DuelHub) ----------------------------------------------------------------

    // Wywołanie huba w kontrakcie HubResult: sukces → wartość; błąd → bezpieczny komunikat (albo cicha resynchronizacja
    // dla spóźnionego / powtórzonego ruchu). Zawieszenie z serwera przełącza stół w tryb tylko do odczytu.
    private async Task<(bool Ok, JsonElement Value)> CallAsync(string method, params object?[] args)
    {
        if (busy)
            return (false, default);
        busy = true;
        error = null;
        lastCode = null;
        try
        {
            var result = await JS.InvokeAsync<JsonElement>("sansPostDuel.invoke", new object?[] { method }.Concat(args).ToArray());
            if (result.ValueKind == JsonValueKind.Object && result.TryGetProperty("succeeded", out var ok) && ok.GetBoolean())
                return (true, result.TryGetProperty("value", out var value) ? value : default);

            lastCode = result.ValueKind == JsonValueKind.Object && result.TryGetProperty("code", out var code) ? code.GetString() : null;
            var message = result.ValueKind == JsonValueKind.Object && result.TryGetProperty("message", out var text) ? text.GetString() : null;
            if (lastCode == "account-suspended")
                restricted = true;
            else if (lastCode is "duel-move-already-submitted" or "duel-stale-round" or "duel-not-started")
                await ResyncAsync();
            else
                error = message is null ? L["Nie udało się — spróbuj ponownie."] : L.Error(lastCode, message);
            return (false, default);
        }
        catch (JSDisconnectedException)
        {
            return (false, default);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResyncAsync()
    {
        var state = await JS.InvokeAsync<JsonElement>("sansPostDuel.invoke", "RequestState");
        if (state.ValueKind == JsonValueKind.Object && state.TryGetProperty("players", out _))
            ApplyState(state);
    }

    private async Task StartTraining()
    {
        var (ok, value) = await CallAsync("StartTraining");
        if (!ok)
            return;
        duel = null;
        ApplyDuel(value);
        focusCards = true;
    }

    private async Task Challenge(string handle)
    {
        note = null;
        var (ok, value) = await CallAsync("ChallengeUser", handle);
        if (ok)
            Upsert(ChallengeOf(value));
    }

    private async Task Accept(string challengeId)
    {
        var (ok, value) = await CallAsync("AcceptChallenge", challengeId);
        if (ok || lastCode == "challenge-not-found")
            challenges.RemoveAll(c => c.ChallengeId == challengeId);
        if (ok)
            ApplyDuel(value);
    }

    private async Task Reject(string challengeId)
    {
        var (ok, _) = await CallAsync("RejectChallenge", challengeId);
        if (ok || lastCode == "challenge-not-found")
            challenges.RemoveAll(c => c.ChallengeId == challengeId);
    }

    private async Task Cancel()
    {
        var (ok, _) = await CallAsync("CancelChallenge");
        if (ok || lastCode == "challenge-not-found")
            challenges.RemoveAll(c => c.Direction == "outgoing");
    }

    private async Task Ready()
    {
        if (duel is null)
            return;
        var (ok, value) = await CallAsync("SetReady", duel.DuelId);
        if (ok)
            ApplyDuel(value);
    }

    // Karta idzie z numerem rundy; do odpowiedzi serwera przyciski są nieaktywne (bez zmiany wyboru, bez podwójnego ruchu).
    private async Task Play(string card)
    {
        if (duel is null || !CanPlay || pending is not null)
            return;
        pending = card;
        pendingRound = duel.Round;
        var (ok, value) = await CallAsync("SubmitMove", duel.DuelId, duel.Round, card);
        if (!ok)
        {
            pending = null;
            return;
        }
        ApplyDuel(value.GetProperty("snapshot"));
        ShowReveal(value.GetProperty("roundResult"));
        refocus = true;
    }

    private async Task Surrender()
    {
        if (duel is null)
            return;
        if (!confirmSurrender)
        {
            confirmSurrender = true;
            return;
        }
        var (ok, value) = await CallAsync("Surrender", duel.DuelId);
        confirmSurrender = false;
        if (ok)
            ApplyDuel(value);
    }

    private async Task Rematch()
    {
        if (duel is null)
            return;
        var (ok, value) = await CallAsync("RequestRematch", duel.DuelId);
        if (ok)
            ApplyDuel(value);
    }

    // "Wróć do sali": gracz odchodzi od zakończonego pojedynku (koniec propozycji rewanżu) i okno się zamyka.
    private async Task Leave()
    {
        if (duel is { Mode: "live", Status: "finished" })
            await CallAsync("LeaveDuel", duel.DuelId);
        if (duel?.Mode == "live")
            duel = null;
        await BarNavigation.UpAsync(Navigation, JS, BarState.Game);
    }

    private async Task FocusAsync()
    {
        var selector = focusCards ? ".game-card:not([disabled])" : focusReady ? ".game-ready-button:not([disabled])" : null;
        var lost = refocus;
        focusCards = focusReady = refocus = false;
        try
        {
            if (selector is not null)
                await JS.InvokeVoidAsync("sansPost.focusInDialogWhenReady", selector, null, false);
            else if (lost)
                await JS.InvokeVoidAsync("sansPostDuel.refocus", ".game-card:not([disabled]), .game-ready-button:not([disabled]), .game-board-title");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (self is null)
            return;
        try
        {
            // Trwający pojedynek na żywo: zamknięcie okna nie zrywa połączenia (to nie rozłączenie — gra toczy się dalej).
            await JS.InvokeVoidAsync("sansPostDuel.detach", duel is { Mode: "live", Status: "in-progress" or "ready-check" });
        }
        catch (JSDisconnectedException)
        {
        }
        self.Dispose();
    }

    private RenderFragment Restricted =>
        @<p class="game-restricted" role="status">
            <Icon Name="@Icons.Lock" Size="16" />
            <span>@L["Możesz przeglądać Stół gry, ale udział w pojedynkach jest obecnie niedostępny."]</span>
        </p>;
}
