@* Stół gry bez trwającego pojedynku: wyzwania (przychodzące i wysłane) z odliczaniem, gracze przy stole do wyzwania
   i trening z manekinem. Lista to tylko przydomki (bez e-maili i UserId) — gracza wskazuje nieprzezroczysty uchwyt.
   Kto może wyzwać albo przyjąć, rozstrzyga serwer (wspólna polityka konta); tu tylko prezentacja. *@
<section class="game-lobby" aria-labelledby="game-lobby-title">
    <h3 class="game-deck-title" id="game-lobby-title">@L["Pojedynek na żywo"]</h3>

    @foreach (var invite in Challenges.Where(c => c.Direction == "incoming"))
    {
        <div class="game-invite" role="group" aria-label="@L.Format("Wyzwanie od {0}", invite.OpponentAlias)">
            <p class="game-invite-text">
                <Icon Name="@Icons.Revolver" Size="18" />
                <span>@((MarkupString)L.Format("{0} wyzywa Cię na pojedynek.", $"<strong>{System.Net.WebUtility.HtmlEncode(invite.OpponentAlias)}</strong>"))</span>
                <span class="game-countdown" data-deadline="@Deadline(invite.LocalDeadline)" aria-hidden="true"></span>
            </p>
            @if (CanPlay)
            {
                <div class="cluster">
                    <button type="button" class="btn btn-primary game-accept" disabled="@Busy" @onclick="() => OnAccept.InvokeAsync(invite.ChallengeId)">@L["Przyjmij"]</button>
                    <button type="button" class="btn game-reject" disabled="@Busy" @onclick="() => OnReject.InvokeAsync(invite.ChallengeId)">@L["Odrzuć"]</button>
                </div>
            }
            else
            {
                <button type="button" class="btn game-reject" disabled="@Busy" @onclick="() => OnReject.InvokeAsync(invite.ChallengeId)">@L["Odrzuć"]</button>
            }
        </div>
    }

    @if (Challenges.FirstOrDefault(c => c.Direction == "outgoing") is { } outgoing)
    {
        <div class="game-invite is-outgoing" role="group" aria-label="@L["Wysłane wyzwanie"]">
            <p class="game-invite-text">
                <Icon Name="@Icons.Clock" Size="18" />
                <span>@((MarkupString)L.Format("Wyzwanie wysłane do {0} — czekamy na odpowiedź.", $"<strong>{System.Net.WebUtility.HtmlEncode(outgoing.OpponentAlias)}</strong>"))</span>
                <span class="game-countdown" data-deadline="@Deadline(outgoing.LocalDeadline)" aria-hidden="true"></span>
            </p>
            <button type="button" class="btn game-cancel" disabled="@Busy" @onclick="OnCancel">@L["Wycofaj wyzwanie"]</button>
        </div>
    }

    <p class="game-lobby-hint" id="game-players-title">@L["Gracze przy stole"]</p>
    @if (Players.Count == 0)
    {
        <p class="game-note game-players-empty">@L["Nikogo więcej nie ma teraz przy stole. Zagraj z manekinem albo poczekaj na rewolwerowca."]</p>
    }
    else
    {
        var waiting = Challenges.Any(c => c.Direction == "outgoing");
        <ul class="game-online" aria-labelledby="game-players-title">
            @foreach (var player in Players)
            {
                <li class="game-online-player">
                    <span class="game-online-dot" aria-hidden="true"></span>
                    <span class="game-online-alias">@player.Alias</span>
                    @if (Challenges.Any(c => c.Direction == "incoming" && c.OpponentAlias == player.Alias))
                    {
                        <span class="game-online-state">@L["wyzywa Cię"]</span>
                    }
                    else if (CanPlay)
                    {
                        <button type="button" class="btn game-challenge" aria-label="@L.Format("Wyzwij: {0}", player.Alias)"
                                disabled="@(Busy || waiting)" @onclick="() => OnChallenge.InvokeAsync(player.Handle)">
                            @L["Wyzwij"]
                        </button>
                    }
                </li>
            }
        </ul>
    }

    @if (Error is not null)
    {
        <Alert Variant="AlertVariant.Warning">@Error</Alert>
    }
    <p class="game-lobby-note" role="status">@Note</p>
</section>

@if (Standings is not null)
{
    <GameStandings Standings="Standings" />
}

@if (CanPlay)
{
    <button type="button" class="btn btn-primary game-start" disabled="@Busy" @onclick="OnTraining">
        <Icon Name="@Icons.Revolver" Size="18" /> @L["Rozpocznij pojedynek treningowy"]
    </button>
}

@code {
    [Parameter] public IReadOnlyList<OnlinePlayer> Players { get; set; } = Array.Empty<OnlinePlayer>();
    [Parameter] public IReadOnlyList<ChallengeView> Challenges { get; set; } = Array.Empty<ChallengeView>();
    [Parameter] public bool CanPlay { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Note { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public StandingsView? Standings { get; set; }
    [Parameter] public EventCallback<string> OnChallenge { get; set; }
    [Parameter] public EventCallback<string> OnAccept { get; set; }
    [Parameter] public EventCallback<string> OnReject { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnTraining { get; set; }

    private static string? Deadline(double value) => value > 0 ? value.ToString("F0", System.Globalization.CultureInfo.InvariantCulture) : null;
}
