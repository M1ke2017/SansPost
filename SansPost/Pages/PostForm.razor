@page "/post-from"
@using Blazored.LocalStorage
@using Microsoft.IdentityModel.Tokens
@using SansPost.Models
@using System.Net.Http.Headers
@using SansPost.Models.Enum
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http
@inject NavigationManager Navigation

@code {
    private PostRequest newPost = new();
    private bool isSubmitting = false;
    private List<string> categories = new() { "Technologia", "Sport", "Edukacja", "Lifestyle", "Podróże" };
    private string errorMessage = "";

    private async Task SubmitPost()
    {
        isSubmitting = true;

        try
        {
            
            var token = await LocalStorage.GetItemAsync<string>("authToken"); 
            if (string.IsNullOrEmpty(token))
            {
                errorMessage = "Brak autoryzacji! Zaloguj się ponownie.";
                isSubmitting = false;
                return;
            }

            var request = new HttpRequestMessage(HttpMethod.Post, "/add-post")
                {
                    Content = JsonContent.Create(newPost)
                };
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            var responseText = await response.Content.ReadAsStringAsync();

            Console.WriteLine($"API Response: {responseText}");

            if (response.IsSuccessStatusCode)
            {
                
                Navigation.NavigateTo("/posts");
            }
            else
            {
                errorMessage = $"Błąd dodawania posta! Kod: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Błąd: {ex.Message}";
            Console.WriteLine($"Error: {ex}");
        }

        isSubmitting = false;
    }

    
    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");

        if (string.IsNullOrWhiteSpace(token))
        {
            Navigation.NavigateTo("/login"); 
            return;
        }

        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

       

    }
}

<link rel="stylesheet" href="css/addpost.css">

<div class="home-container">
    <div class="register-text">
        <h2>Dodaj Nowy Post</h2>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error">@errorMessage</p>
        }

       
        <form @onsubmit="SubmitPost">
            <label for="title">Tytuł</label>
            <input type="text" id="title" placeholder="Podaj tytuł" @bind="newPost.Title" required />

            <label for="category">Kategoria</label>
            <select id="category" @bind="newPost.Category" required>
                <option value="" disabled>Wybierz kategorię</option>
                @foreach (var category in categories)
                {
                    <option value="@category.ToString()">@category</option>
                }
            </select>

            <label for="content">Treść</label>
            <textarea id="content" placeholder="Treść posta" @bind="newPost.Content" required></textarea>

            <label for="imageUrl">Obrazek (opcjonalnie)</label>
            <input type="text" id="imageUrl" placeholder="Podaj URL obrazka" @bind="newPost.ImageUrl" />

            <button type="submit" class="auth-btn" disabled="@isSubmitting">
                @(isSubmitting ? "Dodawanie..." : "Dodaj Post")
            </button>
        </form>

        <button class="cancel-btn" @onclick="@(() => Navigation.NavigateTo("/posts"))">Anuluj</button>
    </div>
</div>
