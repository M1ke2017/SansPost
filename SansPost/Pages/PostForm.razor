@page "/post-from"
@attribute [Authorize]
@inject IPostService PostService
@inject NavigationManager Navigation
@inject ILogger<PostForm> Logger

<link rel="stylesheet" href="css/addpost.css">

<div class="home-container">
    <div class="register-text">
        <h2>Dodaj Nowy Post</h2>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error">@errorMessage</p>
        }

        <form @onsubmit="SubmitPost">
            <label for="title">Tytuł</label>
            <input type="text" id="title" placeholder="Podaj tytuł" @bind="newPost.Title" required />

            <label for="category">Kategoria</label>
            <select id="category" @bind="selectedCategory" required>
                <option value="" disabled>Wybierz kategorię</option>
                @foreach (var category in Enum.GetValues<PostCategory>())
                {
                    <option value="@category">@category.DisplayName()</option>
                }
            </select>

            <label for="content">Treść</label>
            <textarea id="content" placeholder="Treść posta" @bind="newPost.Content" required></textarea>

            <label for="imageUrl">Obrazek (opcjonalnie)</label>
            <input type="text" id="imageUrl" placeholder="Podaj URL obrazka" @bind="newPost.ImageUrl" />

            <button type="submit" class="auth-btn" disabled="@isSubmitting">
                @(isSubmitting ? "Dodawanie..." : "Dodaj Post")
            </button>
        </form>

        <button class="cancel-btn" @onclick="@(() => Navigation.NavigateTo("/posts"))">Anuluj</button>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private readonly PostRequest newPost = new();
    private string selectedCategory = "";
    private bool isSubmitting = false;
    private string errorMessage = "";

    private async Task SubmitPost()
    {
        var userId = (await AuthState).User.GetUserId();
        if (userId is null)
            return;

        isSubmitting = true;
        errorMessage = "";

        try
        {
            newPost.Category = Enum.TryParse<PostCategory>(selectedCategory, out var category) ? category : null;

            var result = await PostService.CreateAsync(userId.Value, newPost);
            if (result.Succeeded)
                Navigation.NavigateTo("/posts");
            else
                errorMessage = result.Message ?? "Błąd dodawania posta!";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd dodawania posta.");
            errorMessage = "Wystąpił błąd. Spróbuj ponownie.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
