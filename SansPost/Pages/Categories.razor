@page "/categories"
@inject UiServices Ui
@inject ILogger<Categories> Logger

<PageTitle>@L["Kategorie · SansPost"]</PageTitle>

<div class="page-header">
    <div>
        <h1>@L["Kategorie"]</h1>
        <p>@L["Każda kategoria to osobne miejsce w miasteczku — i nie wszystkie są o IT. Wybierz, dokąd idziesz."]</p>
    </div>
</div>

@if (failed)
{
    <EmptyState Title="Nie udało się wczytać kategorii" IconName="@Icons.AlertTriangle" Variant="AlertVariant.Danger" Text="@UiErrors.Generic">
        <button type="button" class="btn" @onclick="LoadAsync"><Icon Name="@Icons.Refresh" /> @L["Spróbuj ponownie"]</button>
    </EmptyState>
}
else
{
    <ul class="category-grid list-plain">
        @foreach (var category in CategoryMeta.All)
        {
            var summary = summaries?.FirstOrDefault(s => s.Category == category);
            <li>
                <a class="category-tile @CategoryMeta.CssClass(category)" href="@CategoryMeta.Url(category)">
                    <span class="tile-icon"><Icon Name="@CategoryMeta.Icon(category)" Size="20" /></span>
                    <span class="tile-place">@L[CategoryMeta.Place(category)]</span>
                    <span class="tile-name">@L[category.DisplayName()]</span>
                    <span class="tile-desc">@L[CategoryMeta.Description(category)]</span>
                    <span class="tile-meta">
                        @if (summary is null)
                        {
                            <span>&nbsp;</span>
                        }
                        else if (summary.PostCount == 0)
                        {
                            <span>@L["Jeszcze bez postów"]</span>
                        }
                        else
                        {
                            <span>@UiText.Posts(L, summary.PostCount)</span>
                            @if (summary.LatestPostAt is DateTime latest)
                            {
                                <span> · @L["ostatni"] <TimeAgo Value="latest" /></span>
                            }
                        }
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<CategorySummaryResponse>? summaries;
    private bool failed;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        failed = false;
        try
        {
            summaries = await Ui.Run((IPostService s) => s.GetCategoriesAsync());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd wczytywania kategorii.");
            failed = true;
        }
    }
}
