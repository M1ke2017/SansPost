@page "/register"
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<link rel="stylesheet" href="css/logres.css">

<div class="home-container">
    <div class="register-text">
        <h2>Rejestracja</h2>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error">@errorMessage</p>
        }

        @* Zwykły HTTP POST do AccountController (antiforgery + rate limiting). *@
        <form method="post" action="auth/register">
            <AntiforgeryField />

            <input type="text" id="username" name="Username" placeholder="Podaj nazwę"
                   minlength="3" maxlength="50" pattern="[\p{L}\p{N}._\-]{3,50}" autocomplete="username" required>

            <label for="email">Email</label>
            <input type="email" id="email" name="Email" placeholder="Podaj email" maxlength="254" autocomplete="email" required>

            <label for="password">Hasło</label>
            <div class="password-container">
                <input type="@passwordInputType" id="password" name="Password" placeholder="Podaj hasło (8–64 znaki)"
                       minlength="@PasswordPolicy.MinLength" maxlength="@PasswordPolicy.MaxLength" autocomplete="new-password" required>
                <button type="button" class="toggle-password" @onclick="TogglePassword">
                    @passwordToggleIcon
                </button>
            </div>

            <label for="confirmPassword">Potwierdź hasło</label>
            <div class="password-container">
                <input type="@confirmPasswordInputType" id="confirmPassword" name="ConfirmPassword" placeholder="Powtórz hasło"
                       maxlength="@PasswordPolicy.MaxLength" autocomplete="new-password" required>
                <button type="button" class="toggle-password" @onclick="ToggleConfirmPassword">
                    @confirmPasswordToggleIcon
                </button>
            </div>

            <button type="submit" class="auth-btn">Zarejestruj się</button>
        </form>

        <p>Masz już konto? <a href="/login">Zaloguj się</a></p>
    </div>
</div>

@code {
    private string? errorMessage;

    private bool showPassword = false;
    private bool showConfirmPassword = false;

    private string passwordInputType => showPassword ? "text" : "password";
    private string confirmPasswordInputType => showConfirmPassword ? "text" : "password";
    private string passwordToggleIcon => showPassword ? "👁️" : "🙈";
    private string confirmPasswordToggleIcon => showConfirmPassword ? "👁️" : "🙈";

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (!query.TryGetValue("error", out var error))
            return;

        errorMessage = error.ToString() switch
        {
            "mismatch" => "Hasła nie są identyczne!",
            "conflict" => "Nie można utworzyć konta z podanym emailem lub nazwą użytkownika.",
            _ => $"Sprawdź dane: nazwa 3–50 znaków (litery, cyfry, . _ -), poprawny email, hasło {PasswordPolicy.MinLength}–{PasswordPolicy.MaxLength} znaków."
        };
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private void ToggleConfirmPassword()
    {
        showConfirmPassword = !showConfirmPassword;
    }
}
