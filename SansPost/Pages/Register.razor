@page "/register"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@implements IDisposable
@inject NavigationManager Navigation
@inject PersistentComponentState ApplicationState
@inject UiServices Ui
@inject IOptions<PublicDemoOptions> DemoOptions

<PageTitle>@L["Załóż konto · SansPost"]</PageTitle>

<div class="auth-shell stack">
    <div class="page-header" style="margin-bottom: 0">
        <div>
            <h1>@L["Załóż konto"]</h1>
            <p>@L["Konto pozwala publikować posty, komentować, reagować i zgłaszać treści."]</p>
        </div>
    </div>

    @if (availability == Availability.Checking)
    {
        <p class="muted" role="status">@L["Sprawdzanie dostępności rejestracji…"]</p>
    }
    else if (availability == Availability.Disabled)
    {
        @* Formularz nie udaje, że działa — pokazujemy stan i alternatywę. *@
        <EmptyState Title="Rejestracja jest obecnie wyłączona" IconName="@Icons.Lock" Variant="AlertVariant.Warning"
                    Text="Nowe konta są chwilowo niedostępne. Nadal możesz przeglądać wszystkie posty i dyskusje.">
            <a class="btn btn-primary" href="@SaloonRoutes.Hub">@L["Przeglądaj posty"]</a>
            <a class="btn" href="/login">@L["Mam już konto"]</a>
        </EmptyState>
    }
    else if (availability == Availability.CapacityReached)
    {
        <EmptyState Title="Limit kont został osiągnięty" IconName="@Icons.Users" Variant="AlertVariant.Warning"
                    Text="Publiczna wersja SansPost ma ograniczoną liczbę kont i wszystkie miejsca są zajęte. Wszystkie treści możesz czytać bez konta.">
            <a class="btn btn-primary" href="@SaloonRoutes.Hub">@L["Przeglądaj posty"]</a>
            <a class="btn" href="/login">@L["Mam już konto"]</a>
        </EmptyState>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <Alert Variant="@errorVariant">@L.Text(errorMessage)</Alert>
        }

        <div class="card">
            <div class="card-body">
                @* Zwykły HTTP POST do AccountController (antiforgery + rate limiting). *@
                <form method="post" action="auth/register" data-loading-form>
                    <FormGate Class="stack">
                    <AntiforgeryField />

                    <AliasPicker @bind-Alias="alias" />

                    <div class="field">
                        <label class="field-label" for="email">@L["Email"]</label>
                        <input class="input" type="email" id="email" name="@L["Email"]" maxlength="254" autocomplete="email" required
                               aria-describedby="email-hint" aria-invalid="@(identityTaken ? "true" : null)" />
                        <span class="field-hint" id="email-hint">@L["Nie jest nigdzie wyświetlany."]</span>
                    </div>

                    <div class="field">
                        <label class="field-label" for="password">@L["Hasło"]</label>
                        <PasswordInput Id="password" Name="Password" Autocomplete="new-password" DescribedBy="password-hint"
                                       MinLength="PasswordPolicy.MinLength" MaxLength="PasswordPolicy.MaxLength" />
                        <span class="field-hint" id="password-hint">@L.Format("{0}–{1} znaków.", PasswordPolicy.MinLength, PasswordPolicy.MaxLength)</span>
                    </div>

                    <div class="field">
                        <label class="field-label" for="confirmPassword">@L["Powtórz hasło"]</label>
                        <PasswordInput Id="confirmPassword" Name="ConfirmPassword" Autocomplete="new-password"
                                       MaxLength="PasswordPolicy.MaxLength" Invalid="passwordMismatch"
                                       DescribedBy="@(passwordMismatch ? "confirm-error" : null)" />
                        @if (passwordMismatch)
                        {
                            <span class="field-error" id="confirm-error"><Icon Name="@Icons.AlertCircle" Size="16" /> @L["Hasła nie są identyczne."]</span>
                        }
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg btn-block" data-loading-text="Tworzenie konta…">@L["Załóż konto"]</button>
                    </FormGate>
                </form>
            </div>
        </div>
    }

    <p class="muted text-sm" style="text-align: center">@L["Masz już konto?"] <a href="/login">@L["Zaloguj się"]</a></p>
</div>

@code {
    private enum Availability { Checking, Open, Disabled, CapacityReached }

    private Availability availability = Availability.Checking;
    private string? errorMessage;
    private AlertVariant errorVariant = AlertVariant.Danger;
    private bool passwordMismatch;
    private bool identityTaken;
    private string? alias;
    private PersistingComponentStateSubscription persisting;

    private const string AliasStateKey = "register-alias";

    protected override async Task OnInitializedAsync()
    {
        // Przydomek z prerenderu przechodzi do circuitu — bez "przeskoku" na inny po podłączeniu.
        if (!ApplicationState.TryTakeFromJson<string>(AliasStateKey, out alias) || alias is null)
            alias = await Ui.Run((IAliasGenerator s) => s.SuggestAsync());
        persisting = ApplicationState.RegisterOnPersisting(() =>
        {
            ApplicationState.PersistAsJson(AliasStateKey, alias);
            return Task.CompletedTask;
        });

        // Tylko informacja tak/nie (bez liczby kont). Serwer i tak rozstrzyga limit atomowo przy zapisie.
        availability = !DemoOptions.Value.RegistrationEnabled ? Availability.Disabled
            : await Ui.Run((IAuthService s) => s.IsRegistrationAvailableAsync()) ? Availability.Open
            : Availability.CapacityReached;

        // Cała przestrzeń przydomków zajęta — formularz nie może udawać, że zadziała.
        if (availability == Availability.Open && alias is null)
            availability = Availability.CapacityReached;

        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (!query.TryGetValue("error", out var error))
            return;

        switch (error.ToString())
        {
            case "capacity":
                availability = Availability.CapacityReached;
                break;
            case "disabled":
                availability = Availability.Disabled;
                break;
            case "mismatch":
                passwordMismatch = true;
                errorMessage = AuthText.PasswordMismatch;
                break;
            case "conflict":
                identityTaken = true;
                errorMessage = AuthText.IdentityTaken;
                break;
            case "alias-taken":
                errorVariant = AlertVariant.Warning;
                errorMessage = AuthText.AliasTaken;
                break;
            case "rate-limited":
                errorVariant = AlertVariant.Warning;
                errorMessage = AuthText.RegisterRateLimited;
                break;
            default:
                errorMessage = AuthText.InvalidRegistration;
                break;
        }
    }

    public void Dispose() => persisting.Dispose();
}
