@page "/c/{Slug}"
@inject NavigationManager Navigation

<PageTitle>@(category?.DisplayName() ?? "Kategoria") · SansPost</PageTitle>

@if (category is not PostCategory current)
{
    <EmptyState Title="Nie ma takiej kategorii" HeadingLevel="1" IconName="@Icons.Grid" Text="Sprawdź listę dostępnych kategorii.">
        <a class="btn btn-primary" href="/categories">Wszystkie kategorie</a>
    </EmptyState>
}
else
{
    @* @key: zmiana kategorii odtwarza blok — krótkie "wejście do kolejnego miejsca" (fade + przesunięcie, szyld, linia kurzu). *@
    <div class="stack place-enter @CategoryMeta.CssClass(current)" @key="current">
        <a class="back-link" href="/categories" style="margin-bottom: 0"><Icon Name="@Icons.ArrowLeft" Size="16" /> Kategorie</a>

        <header class="place-header">
            <div class="spread" style="align-items: flex-start">
                <div class="stack-sm" style="min-width: 0">
                    <span class="place-sign">
                        <span class="category-hero-icon"><Icon Name="@CategoryMeta.Icon(current)" Size="24" /></span>
                        <span class="place-name">@CategoryMeta.Place(current)</span>
                    </span>
                    <h1>@current.DisplayName()</h1>
                    <p class="muted">@CategoryMeta.Description(current)</p>
                </div>
                <a class="btn btn-primary" href="@($"/new?category={CategoryMeta.Slug(current)}")"><Icon Name="@Icons.Cactus" /> Napisz w tej kategorii</a>
            </div>
            <div class="dust-line" aria-hidden="true"></div>
            <FrontierScene Variant="signpost" />
        </header>

        <div class="spread">
            <div style="flex: 1; min-width: 0"><CategoryStrip Current="current" /></div>
            <div class="segmented" role="group" aria-label="Sortowanie postów">
                <button type="button" aria-pressed="@(SortValue == PostSort.Newest ? "true" : "false")" @onclick="() => SetSort(PostSort.Newest)">
                    <Icon Name="@Icons.Clock" Size="16" /> Najnowsze
                </button>
                <button type="button" aria-pressed="@(SortValue == PostSort.Popular ? "true" : "false")" @onclick="() => SetSort(PostSort.Popular)">
                    <Icon Name="@Icons.Trending" Size="16" /> Popularne
                </button>
            </div>
        </div>

        <div class="feed-column">
            <FeedList Category="current" Sort="SortValue" Label="@($"Posty w kategorii {current.DisplayName()}")">
                <Empty>
                    <EmptyState Title="@($"Brak postów w kategorii {current.DisplayName()}")" Text="@CategoryMeta.EmptyText(current)">
                        <a class="btn btn-primary" href="@($"/new?category={CategoryMeta.Slug(current)}")">
                            <Icon Name="@Icons.Cactus" /> @(current == PostCategory.Feedback ? "Zostaw opinię" : "Napisz pierwszy post")
                        </a>
                    </EmptyState>
                </Empty>
            </FeedList>
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }

    private PostCategory? category;

    private PostSort SortValue => string.Equals(Sort, "popular", StringComparison.OrdinalIgnoreCase) ? PostSort.Popular : PostSort.Newest;

    protected override void OnParametersSet() =>
        category = CategoryMeta.TryParseSlug(Slug, out var parsed) ? parsed : null;

    private void SetSort(PostSort sort)
    {
        var url = $"/c/{Slug}";
        Navigation.NavigateTo(sort == PostSort.Popular ? url + "?sort=popular" : url);
    }
}
