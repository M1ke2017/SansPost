@page "/saloon"
@page "/posts"
@using SansPost.Features.Demo
@inject UiServices Ui
@inject ScenePreference Preference
@inject ILogger<Saloon> Logger

<PageTitle>SansPost — rozmowy, które mają sens</PageTitle>

@* Saloon — główna przestrzeń SansPost (dawniej "/"). "/posts" to dawny alias feedu — zostaje. Główny plac: baner z pejzażem pogranicza. Gość dostaje wyjaśnienie i wejście; zalogowany — krótkie powitanie. *@
@* Sprint 15: na urządzeniach, które wybrały renderer 3D (ta sama decyzja co Entrance), /saloon to Main Hall 3D (SaloonHall),
   a feed otwiera się w panelu baru. Trzy stany: Pending (sala z warstwą ładowania; klasyczny widok ukryty — tylko dla
   robotów i bez JS), ThreeD (sala) i CssFallback (klasyczny widok poniżej). Klasyczny UI nie jest ekranem ładowania 3D.
   "?scene=3d" / "?scene=css" wymuszają tryb (diagnostyka, testy). *@
@if (renderer != SaloonRenderer.CssFallback)
{
    <SaloonHall Bar="BarValue" Featured="featured" Categories="categories" Force="@(Scene == "3d")" Known3d="known3d" OnDecided="OnHallDecided" />
}

@if (renderer == SaloonRenderer.CssFallback || (renderer == SaloonRenderer.Pending && !known3d))
{
<div class="saloon-classic @(renderer == SaloonRenderer.Pending ? "is-pending" : "")">
@if (Viewer is null)
{
    <section class="frontier-banner" aria-labelledby="intro-title">
        <span class="eyebrow"><Icon Name="@Icons.Signpost" Size="14" StrokeWidth="2" /> Główny plac</span>
        <h1 id="intro-title">Rozmowy, które mają sens.</h1>
        <p>SansPost to miejsce, gdzie ludzie zostawiają wiadomości, opinie i historie — o technologii, grach, podróżach, pomysłach i projektach. Czytasz bez konta; z kontem publikujesz, komentujesz i reagujesz.</p>
        <div class="cluster">
            <a class="btn btn-primary" href="/register">Dołącz do rozmowy</a>
            <a class="btn" href="#feed-title">Przeglądaj posty</a>
        </div>
        <FrontierScene Variant="town" />
    </section>
}
else
{
    <section class="frontier-banner is-compact" aria-labelledby="feed-title">
        <span class="eyebrow"><Icon Name="@Icons.Signpost" Size="14" StrokeWidth="2" /> Główny plac</span>
        <h1 id="feed-title">Odkrywaj</h1>
        <p>Świeże wiadomości ze wszystkich zakątków SansPost.</p>
        <FrontierScene Variant="town" />
    </section>
}

<div class="layout-with-aside">
    <SaloonFeed Sort="SortValue" Featured="featured" HeadingId="@(Viewer is null ? "feed-title" : "feed-list-title")"
                Heading="@(Viewer is null ? "Odkrywaj" : "Posty")" HeadingHidden="Viewer is not null" />

    <aside class="aside" aria-label="Kategorie i informacje">
        @if (categories is not null)
        {
            <div class="card aside-categories">
                <div class="card-body">
                    <div class="spread" style="margin-bottom: var(--space-2)">
                        <h2 class="section-title">Kategorie</h2>
                        <a class="text-sm" href="/categories">Wszystkie</a>
                    </div>
                    <ul class="list-plain category-list">
                        @foreach (var item in categories)
                        {
                            <li class="@CategoryMeta.CssClass(item.Category)">
                                <a href="@CategoryMeta.Url(item.Category)">
                                    <Icon Name="@CategoryMeta.Icon(item.Category)" Size="16" />
                                    <span class="name">@item.Category.DisplayName()</span>
                                    <span class="count" aria-label="@UiText.Posts(item.PostCount)">@UiText.Number(item.PostCount)</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        @* Feedback: naturalne miejsce na opinie — zwykła kategoria, bez osobnego "formularza dla rekrutera". *@
        <div class="card cat-feedback">
            <div class="card-body stack-sm">
                <h2 class="section-title"><Icon Name="@Icons.Megaphone" Size="15" Class="inline-icon" /> Feedback</h2>
                <p class="text-sm">Co działa, co przeszkadza, czego brakuje? Uwagi o SansPost trafiają do kategorii Feedback — jak każda inna rozmowa.</p>
                <div class="cluster">
                    <a class="btn btn-sm" href="@CategoryMeta.Url(PostCategory.Feedback)">Czytaj opinie</a>
                    <a class="btn btn-sm btn-ghost" href="@($"/new?category={CategoryMeta.Slug(PostCategory.Feedback)}")">Zostaw opinię</a>
                </div>
            </div>
        </div>

        <p class="demo-note">
            <Icon Name="@Icons.Info" Size="16" />
            <span>SansPost to projekt portfolio działający na żywo. Treści są prawdziwe, a liczba kont w tej wersji jest ograniczona.</span>
        </p>
    </aside>
</div>

</div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    [CascadingParameter] private ViewerContext? Viewer { get; set; }

    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }

    // "?scene=3d" — sala 3D bez kryteriów wydajności; "?scene=css" — zawsze widok klasyczny.
    [SupplyParameterFromQuery(Name = "scene")] public string? Scene { get; set; }

    // Stan BAR w sali 3D (Karta rozmów i jej poziomy) — patrz BarState. Widok klasyczny go ignoruje.
    [SupplyParameterFromQuery(Name = "bar")] public string? BarParam { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? CategoryParam { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? QueryParam { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public string? PostIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? FromParam { get; set; }
    [SupplyParameterFromQuery(Name = "next")] public string? NextParam { get; set; }
    [SupplyParameterFromQuery(Name = "back")] public string? BackParam { get; set; }

    // Tablica Wanted (Sprint 17): ?wanted=board | post (z id) | login / register — ten sam model stanu co BAR.
    [SupplyParameterFromQuery(Name = "wanted")] public string? WantedParam { get; set; }

    // Kącik muzyczny (Sprint 18): ?music=radio.
    [SupplyParameterFromQuery(Name = "music")] public string? MusicParam { get; set; }

    // Stół gry (Sprint 19): ?game=table (i karta logowania gościa ?game=login).
    [SupplyParameterFromQuery(Name = "game")] public string? GameParam { get; set; }

    private enum SaloonRenderer { Pending, ThreeD, CssFallback }

    private SaloonRenderer renderer;
    private bool known3d;

    private PostCardModel? featured;
    private IReadOnlyList<CategorySummaryResponse>? categories;

    private PostSort SortValue => string.Equals(Sort, "popular", StringComparison.OrdinalIgnoreCase) ? PostSort.Popular : PostSort.Newest;

    private BarState? BarValue => BarState.Parse(BarParam, CategoryParam, Sort, QueryParam, PostIdParam, FromParam, NextParam, BackParam, WantedParam, MusicParam, GameParam);

    protected override async Task OnInitializedAsync()
    {
        // Stan początkowy (także w prerenderze): widok klasyczny tylko przy znanej albo wymuszonej decyzji fallback.
        if (Scene == "css" || (Scene != "3d" && Preference.Renderer == "css"))
            renderer = SaloonRenderer.CssFallback;
        known3d = Scene != "css" && Preference.Renderer == "3d";

        try
        {
            var viewerId = (await AuthState).User.GetUserId();
            var featuredId = await Ui.Run((FeaturedPostLocator s) => s.GetFeaturedPostIdAsync());
            if (featuredId is int id && await Ui.Run((IPostService s) => s.GetByIdAsync(id, viewerId)) is { } post)
                featured = PostCardModel.From(post);

            categories = await Ui.Run((IPostService s) => s.GetCategoriesAsync());
        }
        catch (Exception ex)
        {
            // Dodatki strony głównej — feed działa niezależnie od nich.
            Logger.LogWarning(ex, "Nie udało się wczytać wyróżnionego posta lub kategorii.");
        }
    }

    // Decyzja sali: "3d" (pierwsza klatka narysowana) albo "css" (świadomy fallback) — zapamiętana dla kolejnych stron.
    private void OnHallDecided(string decided)
    {
        renderer = decided == "3d" ? SaloonRenderer.ThreeD : SaloonRenderer.CssFallback;
        Preference.Renderer = decided == "3d" ? "3d" : "css";
    }
}
