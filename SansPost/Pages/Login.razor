@page "/login"
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<link rel="stylesheet" href="css/logres.css">

<div class="home-container">
    <div class="register-text">
        <h2>Logowanie</h2>

        @if (registered)
        {
            <p>Konto utworzone. Możesz się zalogować.</p>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error">@errorMessage</p>
        }

        @* Zwykły HTTP POST — cookie ustawia AccountController, nie circuit SignalR. *@
        <form method="post" action="auth/login">
            <AntiforgeryField />
            <input type="hidden" name="ReturnUrl" value="@returnUrl" />

            <label for="email">Email</label>
            <input type="email" id="email" name="Email" placeholder="Podaj email" autocomplete="username" required>

            <label for="password">Hasło</label>
            <input type="password" id="password" name="Password" placeholder="Podaj hasło" autocomplete="current-password" required>

            <button type="submit" class="auth-btn">Zaloguj się</button>
        </form>

        <p>Nie masz konta? <a href="/register">Zarejestruj się</a></p>
    </div>
</div>

@code {
    private string? returnUrl;
    private string? errorMessage;
    private bool registered;

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);

        returnUrl = query.TryGetValue("returnUrl", out var value) ? value.ToString() : null;
        registered = query.ContainsKey("registered");

        if (query.ContainsKey("error"))
            errorMessage = "Nieprawidłowy email lub hasło.";
    }
}
