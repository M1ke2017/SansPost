@page "/me"
@page "/user-panel"
@attribute [Authorize]
@inject UiServices Ui

<PageTitle>Twoje konto · SansPost</PageTitle>

<div class="stack-lg">
    <div class="page-header" style="margin-bottom: 0">
        <div>
            <h1>Twoje konto</h1>
            <p>Twoje posty, limit publikacji i skróty do najważniejszych miejsc.</p>
        </div>
        <a class="btn btn-primary" href="/new"><Icon Name="@Icons.Plus" /> Nowy post</a>
    </div>

    <div class="layout-with-aside">
        <section aria-labelledby="my-posts">
            <h2 id="my-posts" class="section-title" style="margin-bottom: var(--space-3)">Twoje posty</h2>
            @if (userId is int id)
            {
                <FeedList AuthorId="id" ShowAuthor="false" HeadingLevel="3" Label="Twoje posty">
                    <Empty>
                        <EmptyState Title="Nie masz jeszcze postów" Text="Twoje posty pojawią się tutaj — i na Twoim publicznym profilu.">
                            <a class="btn btn-primary" href="/new"><Icon Name="@Icons.PenSquare" /> Napisz pierwszy post</a>
                        </EmptyState>
                    </Empty>
                </FeedList>
            }
        </section>

        <aside class="aside" aria-label="Konto">
            @if (account is not null)
            {
                <div class="card">
                    <div class="card-body stack">
                        <div class="author-line">
                            <Avatar Username="@account.Username" />
                            <div class="who">
                                <strong class="truncate">@account.Username</strong>
                                <span class="when">Na SansPost od @UiText.MonthYear(account.CreatedAt)</span>
                            </div>
                        </div>

                        <div class="cluster">
                            @if (Viewer?.IsSuspended == true)
                            {
                                <span class="badge badge-warning"><Icon Name="@Icons.Pause" Size="13" /> Konto zawieszone</span>
                            }
                            else
                            {
                                <span class="badge badge-success"><Icon Name="@Icons.CheckCircle" Size="13" /> Konto aktywne</span>
                            }
                            @if (account.Role == UserRole.Admin)
                            {
                                <span class="badge badge-accent"><Icon Name="@Icons.Shield" Size="13" /> Administrator</span>
                            }
                        </div>

                        @if (quota is not null)
                        {
                            <div class="stack-sm">
                                <div class="spread text-sm">
                                    <span>Limit postów</span>
                                    <span class="muted">@quota.Used / @quota.Limit</span>
                                </div>
                                <div class="meter" role="progressbar" aria-label="Wykorzystany limit postów"
                                     aria-valuemin="0" aria-valuemax="@quota.Limit" aria-valuenow="@quota.Used">
                                    <span style="width: @(QuotaPercent)%"></span>
                                </div>
                                <span class="text-xs subtle">
                                    @(quota.Remaining > 0 ? $"Możesz opublikować jeszcze {UiText.Posts(quota.Remaining)}." : "Limit wykorzystany — usuń starszy post, aby dodać nowy.")
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <nav class="card" aria-label="Skróty konta">
                    <div class="card-body stack-sm" style="padding: var(--space-2)">
                        <a class="menu-item" href="@UiText.ProfileUrl(account.Username)"><Icon Name="@Icons.User" /> Mój publiczny profil</a>
                        @if (account.Role == UserRole.Admin)
                        {
                            <a class="menu-item" href="/admin/moderation"><Icon Name="@Icons.Shield" /> Moderacja</a>
                        }
                        <a class="menu-item" href="@CategoryMeta.Url(PostCategory.Feedback)"><Icon Name="@Icons.Megaphone" /> Zostaw opinię o SansPost</a>
                        <form method="post" action="auth/logout">
                            <AntiforgeryField />
                            <button type="submit" class="menu-item"><Icon Name="@Icons.LogOut" /> Wyloguj się</button>
                        </form>
                    </div>
                </nav>
            }
        </aside>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    [CascadingParameter] private ViewerContext? Viewer { get; set; }

    private int? userId;
    private UserResponse? account;
    private PostQuotaResponse? quota;

    private int QuotaPercent => quota is null || quota.Limit == 0 ? 0 : Math.Min(100, quota.Used * 100 / quota.Limit);

    protected override async Task OnInitializedAsync()
    {
        if ((await AuthState).User.GetUserId() is not int id)
            return;

        userId = id;
        account = await Ui.Run((IUserService s) => s.GetByIdAsync(id));
        quota = await Ui.Run((IPostService s) => s.GetQuotaAsync(id));
    }
}
