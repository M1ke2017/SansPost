@page "/user-panel"
@using SansPost.Models
@inject HttpClient Http
@inject NavigationManager Navigation

@code {
    private List<Post>? userPosts;
    private List<Post>? likedPosts;
    private bool showLikedPosts = false;

    protected override async Task OnInitializedAsync()
    {
        userPosts = await Http.GetFromJsonAsync<List<Post>>("/my-posts");
        likedPosts = await Http.GetFromJsonAsync<List<Post>>("/liked-posts");
    }
}

<link rel="stylesheet" href="css/logres.css">

<div class="home-container">
    <div class="register-text">
        <h2>Witaj w swoim panelu</h2>

        <button class="auth-btn" @onclick="@(() => Navigation.NavigateTo("/profile"))">Mój Profil</button>
        <button class="auth-btn" @onclick="@(() => Navigation.NavigateTo("/add-post"))">Dodaj Post</button>
        <button class="auth-btn" @onclick="@(() => showLikedPosts = !showLikedPosts)">
            @(showLikedPosts ? "Moje Posty" : "Polubione Posty")
        </button>

        <h3>@(showLikedPosts ? "Polubione Posty" : "Twoje Posty")</h3>

        <div class="home-container">
            @if (showLikedPosts)
            {
                @if (likedPosts != null && likedPosts.Any())
                {
                    @foreach (var post in likedPosts)
                    {
                        <div class="post-box">
                            <h4>@post.Title</h4>
                            <p>@post.Content</p>
                            <span>Kategoria: @post.Category</span>
                            <span>Data: @post.CreatedAt.ToString("dd-MM-yyyy")</span>
                        </div>
                    }
                }
                else
                {
                    <p>Nie masz polubionych postów.</p>
                }
            }
            else
            {
                @if (userPosts != null && userPosts.Any())
                {
                    @foreach (var post in userPosts)
                    {
                        <div class="post-box">
                            <h4>@post.Title</h4>
                            <p>@post.Content</p>
                            <span>Kategoria: @post.Category</span>
                            <span>Data: @post.CreatedAt.ToString("dd-MM-yyyy")</span>
                        </div>
                    }
                }
                else
                {
                    <p>Nie masz jeszcze postów.</p>
                }
            }
        </div>
    </div>
</div>
