@page "/user-panel"
@attribute [Authorize]
@inject IPostService PostService
@inject NavigationManager Navigation

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private readonly List<PostSummaryResponse> userPosts = new();
    private string? nextCursor;
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        if ((await AuthState).User.GetUserId() is not int id)
            return;

        userId = id;
        await LoadMore();
    }

    private async Task LoadMore()
    {
        var result = await PostService.GetFeedAsync(new PostFeedQuery { AuthorId = userId, Cursor = nextCursor });
        if (!result.Succeeded)
            return;

        userPosts.AddRange(result.Value!.Items);
        nextCursor = result.Value.NextCursor;
    }
}

<link rel="stylesheet" href="css/logres.css">

<div class="home-container">
    <div class="register-text">
        <h2>Witaj w swoim panelu</h2>

        <button class="auth-btn" @onclick="@(() => Navigation.NavigateTo("/post-from"))">Dodaj Post</button>

        <h3>Twoje Posty</h3>

        <div class="home-container">
            @if (userPosts.Any())
            {
                @foreach (var post in userPosts)
                {
                    <div class="post-box">
                        <h4>@post.Title</h4>
                        <p>@post.ContentPreview</p>
                        <span>Kategoria: @post.Category.DisplayName()</span>
                        <span>Data: @post.CreatedAt.ToString("dd-MM-yyyy")</span>
                    </div>
                }
            }
            else
            {
                <p>Nie masz jeszcze postów.</p>
            }

            @if (nextCursor is not null)
            {
                <button class="auth-btn" @onclick="LoadMore">Załaduj więcej</button>
            }
        </div>
    </div>
</div>
