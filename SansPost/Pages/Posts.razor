@page "/posts"
@using SansPost.Features.Search
@inject IPostService PostService
@inject ISearchService SearchService
@inject ILogger<Posts> Logger

<link rel="stylesheet" href="css/posts.css">

<div class="container">
    <div class="main-content">
        <h2>Przeglądaj posty</h2>

        @* Minimalne sterowanie discovery — bez stylizacji (UI/UX w kolejnych sprintach). *@
        <form class="filters" @onsubmit="ApplyAsync">
            <input type="search" @bind="searchText" placeholder="Szukaj w tytułach i treści..." maxlength="@SearchLimits.QueryMaxLength" />

            <select @bind="selectedCategory">
                <option value="">Wszystkie kategorie</option>
                @foreach (var category in Enum.GetValues<PostCategory>())
                {
                    <option value="@category">@category.DisplayName()</option>
                }
            </select>

            <select @bind="selectedSort" disabled="@IsSearching">
                <option value="@PostSort.Newest">Najnowsze</option>
                <option value="@PostSort.Popular">Popularne</option>
            </select>

            <button type="submit">Pokaż</button>
        </form>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error">@errorMessage</p>
        }

        <div class="grid-container">
            @foreach (var item in items)
            {
                <div class="post-card">
                    <span class="category">@item.Category.DisplayName()</span>
                    <h3>@item.Title</h3>
                    <p>@item.Preview@(item.IsTruncated ? "…" : "")</p>
                    <span><a href="@($"/u/{item.AuthorUsername}")">@item.AuthorUsername</a> · ❤ @item.LikeCount · 💬 @item.CommentCount</span>
                    <a href="@($"/post-view/{item.Id}")" class="auth-btn">Więcej</a>
                </div>
            }
        </div>

        @if (!isLoading && items.Count == 0 && string.IsNullOrEmpty(errorMessage))
        {
            <p>Brak postów.</p>
        }

        @if (nextCursor is not null)
        {
            <div class="pagination">
                <button @onclick="LoadMoreAsync" disabled="@isLoading">Załaduj więcej</button>
            </div>
        }

        <div class="register-section">
            <h3>Podziel się z nami przemyśleniami</h3>
            <a href="/post-from" class="register-button">Dodaj Post</a>
        </div>
    </div>
</div>

@code {
    private sealed record ListItem(int Id, string Title, string Preview, bool IsTruncated, PostCategory Category,
        string AuthorUsername, int LikeCount, int CommentCount);

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private readonly List<ListItem> items = new();
    private string searchText = "";
    private string selectedCategory = "";
    private PostSort selectedSort = PostSort.Newest;

    // Parametry aktywnej listy (zatwierdzone przyciskiem) — "Załaduj więcej" kontynuuje dokładnie tę listę.
    private string? activeSearch;
    private PostCategory? activeCategory;
    private PostSort activeSort = PostSort.Newest;
    private string? nextCursor;
    private bool isLoading;
    private string? errorMessage;

    private bool IsSearching => !string.IsNullOrWhiteSpace(searchText);

    protected override Task OnInitializedAsync() => LoadAsync(reset: true);

    private Task ApplyAsync()
    {
        activeSearch = string.IsNullOrWhiteSpace(searchText) ? null : searchText.Trim();
        activeCategory = Enum.TryParse<PostCategory>(selectedCategory, out var category) ? category : null;
        activeSort = selectedSort;
        return LoadAsync(reset: true);
    }

    private Task LoadMoreAsync() => LoadAsync(reset: false);

    private async Task LoadAsync(bool reset)
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var viewerId = (await AuthState).User.GetUserId();
            var cursor = reset ? null : nextCursor;

            if (reset)
                items.Clear();

            if (activeSearch is not null)
            {
                var result = await SearchService.SearchPostsAsync(
                    new PostSearchQuery { Q = activeSearch, Category = activeCategory, Cursor = cursor }, viewerId);
                if (!result.Succeeded)
                {
                    errorMessage = result.Message;
                    nextCursor = null;
                    return;
                }

                items.AddRange(result.Value!.Items.Select(r => new ListItem(r.Id, r.Title, r.Preview, r.IsPreviewTruncated,
                    r.Category, r.AuthorUsername, r.LikeCount, r.CommentCount)));
                nextCursor = result.Value.NextCursor;
            }
            else
            {
                var result = await PostService.GetFeedAsync(
                    new PostFeedQuery { Category = activeCategory, Sort = activeSort, Cursor = cursor }, viewerId);
                if (!result.Succeeded)
                {
                    errorMessage = result.Message;
                    nextCursor = null;
                    return;
                }

                items.AddRange(result.Value!.Items.Select(p => new ListItem(p.Id, p.Title, p.ContentPreview, p.IsContentTruncated,
                    p.Category, p.AuthorUsername, p.LikeCount, p.CommentCount)));
                nextCursor = result.Value.NextCursor;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd pobierania postów.");
            errorMessage = "Nie udało się pobrać postów.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
