@page "/posts"
@inject IPostService PostService
@inject ILogger<Posts> Logger

<link rel="stylesheet" href="css/posts.css">

<div class="container">
    <div class="main-content">
        <h2>Przeglądaj posty</h2>

        <div class="filters">
            <select @onchange="OnCategoryChanged">
                <option value="">Wszystkie kategorie</option>
                @foreach (var category in Enum.GetValues<PostCategory>())
                {
                    <option value="@category">@category.DisplayName()</option>
                }
            </select>
        </div>

        <div class="grid-container">
            @foreach (var post in posts)
            {
                <div class="post-card">
                    <span class="category">@post.Category.DisplayName()</span>
                    <h3>@post.Title</h3>
                    <p>@post.ContentPreview@(post.IsContentTruncated ? "…" : "")</p>
                    <a href="@($"/post-view/{post.Id}")" class="auth-btn">Więcej</a>
                </div>
            }
        </div>

        @if (!isLoading && posts.Count == 0)
        {
            <p>Brak postów.</p>
        }

        @if (nextCursor is not null)
        {
            <div class="pagination">
                <button @onclick="LoadMore" disabled="@isLoading">Załaduj więcej</button>
            </div>
        }

        <div class="register-section">
            <h3>Podziel się z nami przemyśleniami</h3>
            <a href="/post-from" class="register-button">Dodaj Post</a>
        </div>
    </div>
</div>

@code {
    private readonly List<PostSummaryResponse> posts = new();
    private PostCategory? category;
    private string? nextCursor;
    private bool isLoading;

    protected override Task OnInitializedAsync() => LoadAsync(reset: true);

    private Task OnCategoryChanged(ChangeEventArgs e)
    {
        category = Enum.TryParse<PostCategory>(e.Value?.ToString(), out var parsed) ? parsed : null;
        return LoadAsync(reset: true);
    }

    private Task LoadMore() => LoadAsync(reset: false);

    private async Task LoadAsync(bool reset)
    {
        isLoading = true;
        try
        {
            var result = await PostService.GetFeedAsync(new PostFeedQuery
            {
                Category = category,
                Cursor = reset ? null : nextCursor
            });

            if (reset)
                posts.Clear();

            if (result.Succeeded)
            {
                posts.AddRange(result.Value!.Items);
                nextCursor = result.Value.NextCursor;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd pobierania postów.");
        }
        finally
        {
            isLoading = false;
        }
    }
}
