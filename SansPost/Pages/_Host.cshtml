@page "/"
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components.Web
@namespace SansPost.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject IAntiforgery Antiforgery
@{
    // Token antiforgery dla formularzy POST /auth/* renderowanych przez komponenty Blazor.
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
    var clientAddress = HttpContext.Connection.RemoteIpAddress?.ToString();
    // Renderer przestrzeni wybrany wcześniej przez przeglądarkę (3D albo CSS) — prerender /saloon od razu w tym trybie.
    var sceneHint = SansPost.Shared.ScenePreference.Parse(HttpContext.Request.Cookies[SansPost.Shared.ScenePreference.CookieName]);
    // Moduł sceny 3D strony (Entrance albo Main Hall) — tylko te strony dostają wczesny start renderera.
    var scenePage = HttpContext.Request.Path.Value?.ToLowerInvariant() switch
    {
        "/" => "js/entrance3d.js",
        "/saloon" or "/posts" => "js/saloon3d.js",
        _ => null
    };
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ece2d0" />
    <meta name="description" content="SansPost — publiczna przestrzeń rozmów o technologii, grach, podróżach, pomysłach i projektach." />
    <base href="~/" />
    @* Motyw ustawiany przed pierwszym malowaniem (bez mignięcia). Wyłącznie preferencja wyglądu. *@
    <script>
        (function () {
            var theme = null;
            try { theme = localStorage.getItem("sp-theme"); } catch (e) { }
            if (theme !== "light" && theme !== "dark") {
                theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.setAttribute("data-theme", theme);
        })();
    </script>
    <link rel="stylesheet" href="css/app.css" asp-append-version="true" />
    @if (scenePage is not null)
    {
        @* Przestrzenie 3D (Entrance "/", Main Hall "/saloon"): decyzja renderera i pobieranie Three.js startują od razu,
           równolegle z blazor.server.js — nie dopiero po podłączeniu circuitu. Przy znanej decyzji "css" nic się nie pobiera.
           Bez JS: widok CSS/klasyczny zamiast warstwy Pending. *@
        if (sceneHint != "css")
        {
            <link rel="modulepreload" href="js/scene3d-common.js" />
            <link rel="modulepreload" href="@scenePage" />
            if (sceneHint == "3d")
            {
                <link rel="modulepreload" href="lib/three/three.module.min.js" />
            }
            <script type="module">
                const scene = new URLSearchParams(location.search).get("scene");
                if (scene !== "css") import("./js/scene3d-common.js").then(m => m.warmUp(scene === "3d"));
            </script>
        }
        <noscript>
            <style>
                .entrance[data-renderer="pending"] .entrance-stage, .entrance[data-renderer="pending"] .entrance-boardwalk { visibility: visible; opacity: 1; }
                .entrance-pending, .saloon-hall { display: none; }
                .saloon-classic.is-pending { display: contents; }
            </style>
        </noscript>
    }
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" param-AntiforgeryToken="antiforgeryToken"
               param-ClientAddress="clientAddress" param-SceneHint="sceneHint" />

    <div id="blazor-error-ui" role="alert">
        <div class="blazor-error-inner">
            <span>Coś poszło nie tak. Odśwież stronę, aby kontynuować.</span>
            <a href="" class="btn btn-sm reload">Odśwież</a>
            <a class="dismiss" aria-label="Zamknij">✕</a>
        </div>
    </div>

    <div id="components-reconnect-modal" role="alertdialog" aria-labelledby="reconnect-title">
        <div class="reconnect-card">
            <strong id="reconnect-title">Łączenie z SansPost…</strong>
            <p class="muted text-sm when-show">Połączenie zostało przerwane. Próbujemy je przywrócić.</p>
            <div class="stack-sm when-failed">
                <p class="muted text-sm">Nie udało się połączyć ponownie.</p>
                <button type="button" class="btn btn-primary" onclick="location.reload()">Odśwież stronę</button>
            </div>
            <div class="stack-sm when-rejected">
                <p class="muted text-sm">Sesja strony wygasła.</p>
                <button type="button" class="btn btn-primary" onclick="location.reload()">Odśwież stronę</button>
            </div>
        </div>
    </div>

    @* Stan prerenderu przekazywany do circuitu (np. wylosowany przydomek w rejestracji nie zmienia się po podłączeniu). *@
    <persist-component-state />

    <script src="js/sanspost.js" asp-append-version="true"></script>
    <script src="js/music.js" asp-append-version="true"></script>
    <script src="js/duel.js" asp-append-version="true"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
