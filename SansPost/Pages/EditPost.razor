@page "/edit-post/{Id:int}"
@attribute [Authorize]
@inject UiServices Ui
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject ILogger<EditPost> Logger

<PageTitle>Edycja posta · SansPost</PageTitle>

<div class="narrow">
    <a class="back-link" href="@UiText.PostUrl(Id)"><Icon Name="@Icons.ArrowLeft" Size="16" /> Wróć do posta</a>

    @if (isLoading)
    {
        <p class="muted" role="status">Wczytywanie posta…</p>
    }
    else if (loadError is not null)
    {
        <EmptyState Title="Nie udało się wczytać posta" HeadingLevel="1" IconName="@Icons.AlertTriangle" Variant="AlertVariant.Danger" Text="@loadError">
            <button type="button" class="btn" @onclick="LoadAsync"><Icon Name="@Icons.Refresh" /> Spróbuj ponownie</button>
        </EmptyState>
    }
    else if (post is null)
    {
        <EmptyState Title="Ten post nie jest już dostępny" HeadingLevel="1" IconName="@Icons.FileText"
                    Text="Mógł zostać usunięty albo ukryty przez moderację.">
            <a class="btn btn-primary" href="/me">Twoje posty</a>
        </EmptyState>
    }
    else if (!isOwner)
    {
        <EmptyState Title="Możesz edytować tylko własne posty" HeadingLevel="1" IconName="@Icons.Lock">
            <a class="btn btn-primary" href="@UiText.PostUrl(Id)">Wróć do posta</a>
        </EmptyState>
    }
    else
    {
        <div class="page-header">
            <div>
                <h1>Edytuj post</h1>
                <p>Zmiany zobaczą wszyscy czytelnicy. Post zostanie oznaczony jako edytowany.</p>
            </div>
        </div>

        <div class="stack">
            @if (conflict)
            {
                @* 412: nie nadpisujemy cudzej/równoległej zmiany. Decyzja należy do użytkownika. *@
                <Alert Variant="AlertVariant.Warning" Title="Post zmienił się od czasu otwarcia edytora" Focusable="true" @ref="messageAlert">
                    <ChildContent>Twoje zmiany nie zostały zapisane, żeby nie nadpisać nowszej wersji. Wczytaj aktualną wersję i wprowadź zmiany ponownie.</ChildContent>
                    <Actions>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="ReloadCurrentAsync"><Icon Name="@Icons.Refresh" Size="16" /> Wczytaj aktualną wersję</button>
                        <a class="btn btn-sm" href="@UiText.PostUrl(Id)">Anuluj</a>
                    </Actions>
                </Alert>
            }
            else if (errorMessage is not null)
            {
                <Alert Variant="@errorVariant" Focusable="true" @ref="messageAlert">@errorMessage</Alert>
            }

            @if (unsavedCopy is not null)
            {
                <details class="card">
                    <summary class="card-body" style="cursor: pointer">Twoja niezapisana wersja (do skopiowania)</summary>
                    <div class="card-body stack-sm" style="padding-top: 0">
                        <strong>@unsavedCopy.Title</strong>
                        <p class="text-sm" style="white-space: pre-line">@unsavedCopy.Content</p>
                    </div>
                </details>
            }

            <div class="card">
                <div class="card-body">
                    <PostEditor Draft="draft" OnValidSubmit="SaveAsync" Busy="isSaving" Disabled="@(conflict || Viewer?.CanWrite == false)"
                                SubmitLabel="Zapisz zmiany" BusyLabel="Zapisywanie…" PublishIcon="false">
                        <Actions>
                            <a class="btn btn-ghost" href="@UiText.PostUrl(Id)">Anuluj</a>
                            <span class="spacer"></span>
                            <button type="button" class="btn btn-danger" @onclick="() => deleteDialog!.ShowAsync()" disabled="@(Viewer?.CanWrite == false)">
                                <Icon Name="@Icons.Trash" Size="16" /> Usuń post
                            </button>
                        </Actions>
                    </PostEditor>
                </div>
            </div>
        </div>
    }
</div>

<Modal @ref="deleteDialog" Title="Usunąć ten post?">
    <ChildContent>
        <p>Post zniknie z feedu, wyszukiwarki i Twojego profilu razem z dyskusją. Tej operacji nie można cofnąć z poziomu aplikacji.</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn" autofocus @onclick="() => deleteDialog!.CloseAsync()">Anuluj</button>
        <button type="button" class="btn btn-danger-solid" disabled="@isDeleting" @onclick="DeleteAsync">
            @if (isDeleting)
            {
                <span class="spinner" aria-hidden="true"></span>
            }
            Usuń post
        </button>
    </Footer>
</Modal>

@code {
    [Parameter] public int Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    [CascadingParameter] private ViewerContext? Viewer { get; set; }

    private PostDetailsResponse? post;
    private PostDraft draft = new();
    private PostDraft? unsavedCopy;
    private int version;
    private bool isOwner;
    private bool isLoading = true;
    private string? loadError;
    private bool isSaving;
    private bool isDeleting;
    private bool conflict;
    private string? errorMessage;
    private AlertVariant errorVariant = AlertVariant.Danger;
    private Alert? messageAlert;
    private Modal? deleteDialog;
    private bool focusMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            var userId = (await AuthState).User.GetUserId();
            post = await Ui.Run((IPostService s) => s.GetByIdAsync(Id, userId));
            if (post is not null)
            {
                isOwner = post.AuthorId == userId;
                // Wersja z chwili otwarcia edytora — odpowiednik ETag/If-Match w REST.
                version = post.Version;
                draft = new PostDraft { Title = post.Title, Content = post.Content, Category = post.Category };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd ładowania posta {PostId}.", Id);
            loadError = UiErrors.Generic;
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusMessage && messageAlert is not null)
        {
            focusMessage = false;
            await messageAlert.Element.FocusAsync();
        }
    }

    private async Task SaveAsync()
    {
        if ((await AuthState).User.GetUserId() is not int userId || post is null)
            return;

        isSaving = true;
        errorMessage = null;
        try
        {
            var result = await Ui.Run((IPostService s) => s.UpdateAsync(userId, Id, version, draft.ToRequest(post.ImageUrl)));
            if (result.Succeeded)
            {
                Toasts.Success("Zmiany zapisane.");
                Navigation.NavigateTo(UiText.PostUrl(Id));
                return;
            }

            HandleFailure(result);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd zapisu posta {PostId}.", Id);
            errorMessage = UiErrors.Generic;
            focusMessage = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if ((await AuthState).User.GetUserId() is not int userId)
            return;

        isDeleting = true;
        try
        {
            var result = await Ui.Run((IPostService s) => s.DeleteAsync(userId, Id, version));
            await deleteDialog!.CloseAsync();

            if (result.Succeeded)
            {
                Toasts.Success("Post usunięty.");
                Navigation.NavigateTo("/me");
                return;
            }

            HandleFailure(result);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd usuwania posta {PostId}.", Id);
            errorMessage = UiErrors.Generic;
            focusMessage = true;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void HandleFailure(ServiceResult result)
    {
        if (UiErrors.EndsSession(result))
        {
            Navigation.NavigateTo("/login?ended=1", forceLoad: true);
            return;
        }

        if (result.Error == ServiceError.PreconditionFailed)
        {
            conflict = true;
            unsavedCopy = draft.Clone();
        }
        else
        {
            errorMessage = UiErrors.Describe(result, notFound: "Ten post nie jest już dostępny — mógł zostać usunięty lub ukryty.");
            errorVariant = UiErrors.Variant(result);
        }

        focusMessage = true;
    }

    private async Task ReloadCurrentAsync()
    {
        conflict = false;
        await LoadAsync();
        if (post is not null)
            Toasts.Success("Wczytano aktualną wersję posta.");
    }
}
