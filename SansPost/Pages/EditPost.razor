@page "/edit-post/{Id:int}"
@attribute [Authorize]
@inject IPostService PostService
@inject NavigationManager Navigation
@inject ILogger<EditPost> Logger

<link href="css/editpost.css" rel="stylesheet" />

@if (isLoading)
{
    <p style="color:white;">Ładowanie danych posta...</p>
}
else if (post is null)
{
    <p style="color:red;">Nie znaleziono posta lub brak uprawnień.</p>
}
else
{
    <div class="edit-container">
        <h2>Edytuj post</h2>

        @if (!string.IsNullOrEmpty(message))
        {
            <p>@message</p>
        }

        <form class="edit-form" @onsubmit="UpdatePost">
            <input @bind="post.Title" placeholder="Tytuł" />

            <select @bind="selectedCategory">
                <option disabled value="">-- wybierz kategorię --</option>
                @foreach (var category in Enum.GetValues<PostCategory>())
                {
                    <option value="@category">@category.DisplayName()</option>
                }
            </select>

            <textarea @bind="post.Content" placeholder="Treść posta"></textarea>

            <div class="button-row">
                <button type="submit" class="save-button">Zapisz zmiany</button>
                <button type="button" class="delete-button" @onclick="DeletePost">Usuń post</button>
            </div>

        </form>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private PostRequest? post;
    private int version;
    private string selectedCategory = "";
    private bool isLoading = true;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userId = (await AuthState).User.GetUserId();
            var existing = await PostService.GetByIdAsync(Id, userId);

            if (existing is not null && existing.AuthorId == userId)
            {
                post = new PostRequest
                {
                    Title = existing.Title,
                    Content = existing.Content,
                    ImageUrl = existing.ImageUrl
                };
                selectedCategory = existing.Category.ToString();
                version = existing.Version;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd ładowania posta {PostId}.", Id);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdatePost()
    {
        var userId = (await AuthState).User.GetUserId();
        if (post is null || userId is null)
            return;

        post.Category = Enum.TryParse<PostCategory>(selectedCategory, out var category) ? category : null;

        // Wersja z chwili wczytania — jeśli ktoś zmienił post w międzyczasie, zapis zostanie odrzucony.
        var result = await PostService.UpdateAsync(userId.Value, Id, version, post);
        if (result.Succeeded)
        {
            version = result.Value!.Version;
            message = "Post zaktualizowany!";
        }
        else
        {
            message = result.Message;
        }
    }

    private async Task DeletePost()
    {
        var userId = (await AuthState).User.GetUserId();
        if (userId is null)
            return;

        var result = await PostService.DeleteAsync(userId.Value, Id, version);
        if (result.Succeeded)
            Navigation.NavigateTo("/posts");
        else
            message = result.Message ?? "Nie udało się usunąć posta.";
    }
}
