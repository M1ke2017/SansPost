@page "/u/{Username}"
@using SansPost.Features.Profiles
@inject IProfileService ProfileService

<link rel="stylesheet" href="css/logres.css">

<div class="home-container">
    <div class="register-text">
        @if (isLoading)
        {
            <p>Ładowanie profilu...</p>
        }
        else if (profile is null)
        {
            <p class="error">Nie znaleziono użytkownika.</p>
        }
        else
        {
            <h2>@profile.Username</h2>
            <p>Dołączył(a): @profile.JoinedAt.ToLocalTime().ToString("dd-MM-yyyy")</p>
            <p>Posty: @profile.PostCount · Komentarze: @profile.CommentCount</p>

            <h3>Ostatnie posty</h3>
            @if (profile.RecentPosts.Count == 0)
            {
                <p>Brak postów.</p>
            }
            @foreach (var post in profile.RecentPosts)
            {
                <div class="post-box">
                    <h4><a href="@($"/post-view/{post.Id}")">@post.Title</a></h4>
                    <span>@post.Category.DisplayName() · ❤ @post.LikeCount · 💬 @post.CommentCount</span>
                </div>
            }

            <h3>Ostatnie komentarze</h3>
            @if (profile.RecentComments.Count == 0)
            {
                <p>Brak komentarzy.</p>
            }
            @foreach (var comment in profile.RecentComments)
            {
                <div class="post-box">
                    <p>@comment.ContentPreview</p>
                    <span>pod <a href="@($"/post-view/{comment.PostId}")">@comment.PostTitle</a> · @comment.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy")</span>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public string Username { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private PublicProfileResponse? profile;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        profile = await ProfileService.GetByUsernameAsync(Username, (await AuthState).User.GetUserId());
        isLoading = false;
    }
}
